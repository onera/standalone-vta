# ==========================================
# Standalone VTA - Main .gitignore
# ==========================================

# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Build and Outputs
# ------------------------------------------
/**/build/
out/
compiler_output/
simulators_output/
training_output/
log_output/

# Vitis Generated Files
# (We ignore contents but keep the folder structures)
src/fpga/software/gen/*
src/fpga/software/vitis_workspace/*

# Datasets
# ------------------------------------------
datasets/

# Binaries & Executables
# ------------------------------------------
*.o
*.bin
*.exe
*.out

# Execution info and temp files
# ------------------------------------------
prompt*.txt
tempo*.txt

# IDEs & Package Managers
# ------------------------------------------
.idea/
.vscode/
.metals/
.bloop/
.pixi/
