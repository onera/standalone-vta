package build.modules

import mill._
import build.HasFpgaBoard
import build.HasVtaConfig
import mill.api.BuildCtx
import mainargs.arg
import build.modules.{simulator,compiler,fpga,hardware}

/** The per-(model, config) pipeline, split by domain so a module can compose
  * the parts it needs instead of inheriting all of them.
  *
  * Every trait here that needs the config reaches it through HasVtaConfig alone
  * (directly, or transitively through another trait in this file), and the
  * board-dependent ones through HasFpgaBoard; both come from build.mill.
  * Nothing here reads the global -Dvta.config.file: an example's config is a
  * cross value, which is what makes each (model, config) pair cache
  * independently.
  */

/** A model compiled to VTA binaries, whatever front end produced it.
  *
  * The axis the simulator tasks hang off: they need a compiled model and know
  * whether it has a golden to check against, but not where it came from.
  */
trait HasCompilableModel extends Module with HasVtaConfig {

  /** This model's name, which keys its outputs. */
  def modelKey: String

  /** Compile this model for this config, writing the .bin / .csv streams to
    * this task's dest.
    */
  def compile: Task.Simple[PathRef]

  /** Whether a golden reference exists, so the simulator tasks check their
    * output against it. A hand-written VTA IR fixture has none.
    */
  def hasReference: Boolean = true

  /** Flags prepended to every simulator invocation.
    *
    * Emitted before the caller's args so repeating a flag overrides them: the
    * fsim parser assigns on each occurrence, so the last one wins
    * (modules/simulator/src/fsim_main.cc:80).
    */
  def defaultSimFlags: Seq[String] = Seq.empty

  /** This model's reference dir (input_nn.bin + reference.bin), when its front
    * end has one.
    *
    * None by default, so a raw VTA IR fixture never exposes a reference it does
    * not have: the simulator then falls back to the compiler's per-op
    * input{suffix}.bin, which is what those fixtures ship. [[HasOnnxModel]] is
    * the only override; every other consumer here derives from it.
    *
    * Task.Anon because the ONNX override evaluates the `reference` task, and
    * because an Anon has no dest of its own to be relocated to `.super.<Trait>`
    * the way a re-declared cached task would.
    */
  def referenceDir: Task[Option[os.Path]] = Task.Anon { None }

  /** `--ref-dir <dir>` for the simulators, or nothing when there is no
    * reference. Derived from [[referenceDir]] so the flag and the dir the
    * checker reads can never disagree.
    */
  def referenceArgs: Task[Seq[String]] = Task.Anon {
    referenceDir().toSeq.flatMap(d => Seq("--ref-dir", d.toString))
  }
}

/** An ONNX model and its compilation to VTA binaries. */
trait HasOnnxModel extends HasCompilableModel {

  /** Directory the model files live in. */
  def onnxRoot: os.Path

  /** The ONNX model of this example, under onnxDir/<modelKey>.onnx. */
  def onnxPath = Task.Source(onnxRoot / os.RelPath(s"$modelKey.onnx"))

  /** Compile this model for this config: nn_compiler and vta_compiler.
    *
    * Writes the .bin / .csv streams to this task's dest. Cached: re-runs only
    * when the model, the config content or the compiler sources change. The
    * reference is not run here - see [[reference]].
    */
  // The compiler-source dependency comes from the runner, which declares it.
  def compile = Task {
    configSignature() // invalidate on config-content change
    val compOut = Task.dest
    compiler
      .runner()
      .compileModel(onnxPath().path, configPath, compOut)
    PathRef(compOut, quick = true)
  }

  /** Run the ONNX reference for this model: input_nn.bin (the network input)
    * and reference.bin (the golden output), in this task's dest.
    *
    * Returns the directory, not just reference.bin, because the baremetal
    * codegen needs input_nn.bin from it too. Every consumer must resolve this
    * one task: the DDR scratch region is sized from input_nn.bin, so two
    * instances would corrupt the memory map silently rather than failing.
    */
  def reference = Task {
    compiler
      .runner()
      .runReference(onnxPath().path, compile().path, Task.dest)
    PathRef(Task.dest)
  }

  override def referenceDir = Task.Anon { Some(reference().path) }
}

/** A hand-written VTA IR fixture and its compilation to VTA binaries.
  *
  * The front-endless path: the fixture is already VTA IR, so vta_compiler runs
  * alone. There is no ONNX model, hence no nn_compiler and no reference. That
  * also rules out NN mode, since run_nn reads dependency.csv, which only
  * nn_compiler writes, and input_nn.bin, which only the ONNX reference writes,
  * so these fixtures run single-layer.
  */
trait HasRawIrModel extends HasCompilableModel {

  /** Directory the IR fixtures live in. */
  def irRoot: os.Path

  /** The one VTA IR layer a fixture holds, and the layer the simulators run. */
  def irLayer: Int = 0

  /** This fixture's IR: `<irRoot>/<modelKey>.json`. */
  def irPath = Task.Source(irRoot / os.RelPath(s"$modelKey.json"))

  /** The file a single-layer simulator run writes into its output dir
    * (modules/simulator/src/fsim_single_layer.cc:140).
    */
  def layerOutputName: String = s"layer${irLayer}_output.bin"

  override def hasReference = false

  override def defaultSimFlags = Seq("--layer", irLayer.toString)

  /** Compile this fixture for this config: generate its operands, then
    * vta_compiler.
    *
    * Writes the .bin / .csv streams to this task's dest. Cached: re-runs only
    * when the fixture, the config content or the compiler sources change.
    */
  def compile = Task {
    configSignature() // invalidate on config-content change
    compiler
      .runner()
      .compileIr(irPath().path, configPath, Task.dest)
    PathRef(Task.dest, quick = true)
  }
}

/** Functional and Verilated RTL simulation of a compiled model. */
trait SimTasks extends HasCompilableModel {

  /** One simulator leg: run `binary` on this model's compiled output, then
    * check the result against the reference when the model has one.
    *
    * `binary` is the *task* that builds the simulator, not its result: a
    * `Task[T]` parameter can be applied inside the Anon, which is what lets
    * fsim, vsim and layerDumps share this body (see `RunModule.runForkedTask`).
    *
    * `Task.dest` inside an Anon is the dest of the cached task that applies it,
    * so each caller still writes its run to its own directory.
    */
  protected def simRun(
    binary: Task[PathRef],
    flags: Seq[String],
    isRtl: Boolean = false,
    check: Boolean = hasReference
  ): Task[PathRef] = Task.Anon {
    val compOut = compile().path
    val simOut = Task.dest
    val refDir = referenceDir()
    simulator(configKey)
      .runner()
      .launch(
        binary().path,
        Seq("--comp-dir", compOut.toString, "--output", simOut.toString)
          ++ referenceArgs() ++ defaultSimFlags ++ flags
      )
    // A fixture without a golden has nothing to check against
    if (check)
      compiler
        .runner()
        .runCheck(compOut, refDir.get, simOut, rtl = isRtl)
    PathRef(simOut)
  }

  /** Run the functional (C++) simulator on this example and check its output
    * against the ONNX reference.
    *
    * Compiles the model first if stale. Always simulates, so it is the task to
    * use when passing flags.
    *
    * @param args
    *   extra flags forwarded to the fsim binary, e.g. `--layer 3 --verbose` to
    *   run and print a single VTA layer.
    */
  def fsim(args: Args) = Task.Command {
    simRun(simulator(configKey).fsimBinary, args.value)()
  }

  /** Run the Verilated RTL (Chisel) simulator on this example and check its
    * output against the ONNX reference.
    *
    * Compiles the model first if stale, and rebuilds the RTL/vsim binary if the
    * hardware changed. Always simulates.
    *
    * @param args
    *   extra flags forwarded to the vsim binary, e.g. `--no-timeout`, `--trace`
    *   (waveform per layer), `--layer 3`, `--dump-layers`.
    */
  def vsim(args: Args) = Task.Command {
    simRun(
      simulator(configKey).vsimBinary,
      args.value,
      isRtl = true
    )()
  }


  /** Run both simulators on this fixture and byte-compare their outputs.
    *
    */
  def check() = Task.Command {
    val compOut = compile().path
    val fsimBin = build.modules.simulator(configKey).fsimBinary().path
    val vsimBin = build.modules.simulator(configKey).vsimBinary().path
    val sim = build.modules.simulator(configKey).runner()
    val compare = build.modules.compiler.runner()
    val fsimOut = Task.dest / "fsim"
    val vsimOut = Task.dest / "vsim"

    sim.launch(
      fsimBin,
      Seq("--comp-dir", compOut.toString, "--output", fsimOut.toString)
        ++ defaultSimFlags
    )
    sim.launch(
      vsimBin,
      Seq("--comp-dir", compOut.toString, "--output", vsimOut.toString)
        ++ defaultSimFlags ++ Seq("--no-timeout")
    )
    compare.runCompare(fsimOut / "final_output.bin", vsimOut / "final_output_rtl.bin")
    PathRef(Task.dest)
  }
}

/** The per-layer fsim goldens, and so the NN-mode half of the pipeline.
  *
  * Split out of SimTasks because [[layerDumps]] runs the simulator in
  * full-network mode, which needs dependency.csv, which only nn_compiler
  * writes, and input_nn.bin, which only the ONNX reference writes. Mixing it in
  * is therefore a claim that this model came through the ONNX front end; a raw
  * VTA IR fixture must not inherit it, or it would expose a task that can only
  * fail. Its two consumers, BaremetalTasks and PostSynthTasks, name it
  * explicitly.
  */
trait LayerDumpTasks extends SimTasks {

  /** Per-layer fsim golden dumps for this example: input<suffix>.bin and
    * output<suffix>.bin in this task's dest.
    *
    * The reference set the on-board isolation runners and the post-synth
    * compare check against. Compiles the model first if stale; cached, so the
    * dump is shared by [[BaremetalTasks.genBaremetalDebug]] and
    * [[PostSynthTasks.postSynth]].
    */
  // check = false: this is the golden producer, so there is nothing to compare
  // it against here. Like every other leg it gets defaultSimFlags, so the dumps
  // are produced the way the runs checked against them are.
  def layerDumps = Task {
    simRun(
      simulator(configKey).fsimBinary,
      Seq("--dump-layers"),
      check = false
    )()
  }
}

/** Baremetal PS codegen and the SD-card file sets. */
trait BaremetalTasks extends LayerDumpTasks {

  /** DDR base address used by the baremetal codegen, from -Dvta.ddr.base
    * (default 0x0). Must match the board's DDR base, e.g. 0x10000000.
    *
    * The one knob of this pipeline that is still a global property rather than
    * a cross value, because it is a property of the board the artifacts are
    * flashed to, not of the (model, config) pair they are built from.
    */
  def vtaDdrBase = Task.Input {
    build.getVtaArg("vta.ddr.base")
  }

  /** SD-card subfolder this model's files live in: the model name, so several
    * models can share one card (`0:/<model>/instructions_L0.bin`). Emitted into
    * nn_sd_manifest.h as NN_SD_DIR.
    */
  def sdDir: String = modelKey

  /** Generate the baremetal PS headers (nn_exec_plan.h, nn_ddr_map.h, ...) for
    * this example into this task's dest.
    *
    * Compiles the model first if stale. No Vivado needed. Cached: re-runs when
    * the compile inputs, the config or -Dvta.ddr.base change. The SD manifest
    * is always emitted (so `--data-loader sd` builds) but nothing is staged -
    * use [[sdCard]] for the copy-to-card file set.
    */
  // Writes into this task's dest, never the tracked modules/fpga/software/gen/ dir
  // that a Vitis build reads from: a cached task must not silently overwrite it.
  def genBaremetal = Task {
    baremetalGen(noGolden, Seq("--no-stage-sd-files"))()
    PathRef(Task.dest)
  }

  /** The baremetal codegen, shared by the four tasks that differ only in which
    * flags they pass and whether they wire in the fsim goldens.
    *
    * `goldenDir` is a *task*, not a value, so it can be applied inside the
    * Anon: the debug variants hand in [[LayerDumpTasks.layerDumps]], the plain
    * ones nothing. `Task.dest` here is the dest of whichever cached task
    * applies it, so all four keep their own output dir out of one body.
    */
  protected def baremetalGen(
    goldenDir: Task[Option[PathRef]],
    extraArgs: Seq[String]
  ): Task[Unit] = Task.Anon {
    val compileDir = compile().path
    val refDir = referenceDir().getOrElse(
      sys.error("the baremetal codegen needs a reference (ONNX front end only)")
    )
    val golden = goldenDir()
    // --emit-cpu-check only adds a header, it changes no DDR layout, so one gen
    // dir serves both run_nn_debug and run_nn_cpu_debug.
    val debugArgs = golden.toSeq.flatMap(g =>
      Seq(
        "--emit-layer-check",
        "--emit-cpu-check",
        "--golden-dir",
        g.path.toString
      )
    )
    fpga.software.runGenNnBaremetal(
      fpga.software.runner(),
      compileDir,
      refDir,
      configKey,
      vtaDdrBase(),
      Seq("--emit-sd-manifest", "--sd-dir", sdDir) ++ debugArgs ++ extraArgs
    )
  }

  /** No goldens: the plain codegen path. */
  protected def noGolden: Task[Option[PathRef]] = Task.Anon { None }

  /** This example's fsim goldens, for the isolation-runner codegen path. */
  protected def fsimGolden: Task[Option[PathRef]] = Task.Anon {
    Some(layerDumps())
  }

  /** Stage this example's SD-card file set: the .bin streams the runtime `sd`
    * loader reads, under `<dest>/sd_card/<model>/`.
    *
    * Re-runs the codegen with staging enabled into its own dest; the layout is
    * deterministic, so the addresses match the app built from [[genBaremetal]]
    * (every emitted header is byte-identical, the staged sd_card/ tree is the
    * only difference). Not used by the Vitis tasks - it only produces files to
    * copy to a FAT32 card. For the isolation runners use [[sdCardDebug]], which
    * also stages the goldens.
    */
  def sdCard() = Task.Command {
    baremetalGen(noGolden, Seq.empty)()
    println(s"[INFO] copy ${Task.dest / "sd_card" / sdDir} to the SD card root")
    PathRef(Task.dest / "sd_card")
  }

  /** Baremetal PS headers for the on-board isolation runners: [[genBaremetal]]
    * plus nn_debug_map.h and nn_cpu_debug_map.h, wired to this example's fsim
    * goldens ([[layerDumps]]).
    *
    * Cached like [[genBaremetal]], with the golden dump as an extra input. One
    * gen dir serves both run_nn_debug and run_nn_cpu_debug: --emit-cpu-check
    * only adds a header, it changes no DDR layout.
    */
  def genBaremetalDebug = Task {
    baremetalGen(fsimGolden, Seq("--no-stage-sd-files"))()
    PathRef(Task.dest)
  }

  /** Stage the SD-card file set for the isolation runners: the model .bin
    * streams *and* the per-layer goldens, under `<dest>/sd_card/<model>/`.
    *
    * What `addVitisDebugApps --data-loader sd` needs on the card; the plain
    * [[sdCard]] set has no references and cannot drive a debug run.
    */
  def sdCardDebug() = Task.Command {
    baremetalGen(fsimGolden, Seq.empty)()
    println(s"[INFO] copy ${Task.dest / "sd_card" / sdDir} to the SD card root")
    PathRef(Task.dest / "sd_card")
  }
}

/** Vitis workspace and application creation. */
trait VitisTasks extends BaremetalTasks with HasFpgaBoard {

  /** Add this example's app components to the shared Vitis workspace of its
    * (config, board), ready to build and flash.
    *
    * The workspace and its hardware platform are per (config, board) only -
    * `targets[<config>,<board>].vitisPlatform`, built first if stale (which
    * synthesizes the XSA if needed). This task adds the model-dependent part on
    * top: app components named `<model>_<runner>[_<loader>]`, wired to this
    * example's generated headers ([[genBaremetal]]). Several models therefore
    * coexist in one workspace per platform. Requires Vivado and Vitis.
    *
    * The board comes from -Dvta.board.name (default zcu104).
    *
    * @param args
    *   extra flags forwarded to create_vitis_workspace.py, e.g. `--runner
    *   <app>`, `--data-loader sd`.
    */
  def createVitisProject(args: Args) = Task.Command {
    vitisApps(genBaremetal, args.value)()
  }

  /** Add app components for this example to the shared Vitis workspace of its
    * (config, board), building the platform first if stale.
    *
    * Shared by [[createVitisProject]] and [[addVitisDebugApps]], which differ
    * only in which generated-header task they wire in and which defaults they
    * prepend; `genDir` is a *task* so it can be applied inside the Anon.
    */
  protected def vitisApps(
    genDir: Task[PathRef],
    extraArgs: Seq[String]
  ): Task[String] = Task.Anon {
    val gen = genDir().path
    val ws =
      os.Path(build.targets(configKey, fpgaBoard).vitisPlatform())
    val manifest = build
      .targets(configKey, fpgaBoard)
      .synth()
      .path / "manifest.json"
    fpga.software
      .vitisRunner()
      .addApps(
        workspace = ws,
        namePrefix = modelKey,
        cpu = Some(fpga.readManifestField(manifest, "cpu")),
        genDir = Some(gen),
        extraArgs = extraArgs
      )
    ws.toString
  }

  def checkUartOutput = Task.Anon {
    val refOut = referenceDir().getOrElse(
      sys.error("the uart check needs a reference (ONNX front end only)")
    )
    fpga.software
      .runner()
      .run(
        args = (
          "output.bin",
          "--comp-dir",
          compile().path,
          "--ref",
          refOut / "reference.bin"
        ),
        mainClass = "fpga.host.checkers.CheckOutput",
        forkArgs = Seq(s"-Dvta.config.file=${configKey}.json")
      )
  }

  /** Run the uart com script (run_nn_uart application must be running on the
    * FPGA board before launch, build [[createVitisProject]] with `--runner
    * run_nn_uart`, then build and run with vitis)
    */
  def runUart(
    @arg(doc = "port name (ex: /dev/tty0,COM1)") port: String,
    args: Args
  ) = Task.Command {
    val refOut = referenceDir().getOrElse(
      sys.error("the uart runner needs a reference (ONNX front end only)")
    )
    fpga.software.runUartScript(
      refOut / "input_nn.bin",
      Task.dest,
      compile().path,
      port,
      args.value
    )
    checkUartOutput()
    Task.dest
  }

  /** Create a Vitis workspace for this example from an XSA you already have,
    * with no Vivado run at all.
    *
    * The synthesis-driven path is [[createVitisProject]]; this command shares
    * only the generated headers ([[genBaremetal]]) with it. Mill fills in just
    * what it knows - the workspace dir, this model's headers and the app-name
    * prefix - and each can be overridden by repeating the flag in `args`, since
    * the script keeps the last occurrence. The workspace defaults to
    * `build/vitis/<model>_<config>` so a rerun reuses the platform it built.
    *
    * @param args
    *   create_vitis_workspace.py flags. `--xsa <file>` is required; typically
    *   also `--runner run_nn`, `--data-loader elf`, and `--cpu <name>` for a
    *   non-ZynqMP board (default psu_cortexa53_0).
    */
  def createVitisProjectFromXsa(
    @arg(doc = "XSA file used to build the platform") xsa: String,
    args: Args
  ) = Task.Command {
    val genDir = genBaremetal().path
    val ws = BuildCtx.workspaceRoot / "build" / "vitis" /
      s"${modelKey}_$configKey"
    val xsaPath = os.Path(xsa, BuildCtx.workspaceRoot)
    // No --cpu: on this path it comes from `args`, along with --xsa.
    fpga.software
      .vitisRunner()
      .addApps(
        workspace = ws,
        namePrefix = modelKey,
        genDir = Some(genDir),
        extraArgs = Seq("--xsa", xsaPath.toString) ++ args.value
      )
    ws.toString
  }

  /** Add this example's on-board isolation app to the shared Vitis workspace of
    * its (config, board): fsim goldens, debug headers and app in one step.
    *
    * Same workspace and platform as [[createVitisProject]] (so it synthesizes
    * if stale), but the app is wired to [[genBaremetalDebug]]. Defaults to
    * `--runner run_nn_debug --data-loader elf`, emitted *before* the forwarded
    * args so a later value overrides them (argparse keeps the last occurrence).
    *
    * @param args
    *   extra flags for create_vitis_workspace.py, e.g. `--runner
    *   run_nn_cpu_debug`, `--data-loader sd` (stage the card with
    *   [[sdCardDebug]] first), `--pl-reset-between-layers`.
    */
  def addVitisDebugApps(args: Args) = Task.Command {
    vitisApps(
      genBaremetalDebug,
      Seq("--runner", "run_nn_debug", "--data-loader", "elf") ++ args.value
    )()
  }
}

/** Post-synthesis gate-level checking. */
trait PostSynthTasks extends LayerDumpTasks with HasFpgaBoard {

  /** End-to-end post-synthesis gate-level check for this example on the active
    * board (-Dvta.board.name): compile the model, dump the per-layer fsim
    * goldens, emit the post-synth TB, run xsim behavioral + netlist against the
    * cached gate-level netlist, and strb-compare the netlist OUT to the golden.
    * All artifacts land under this task's dest.
    *
    * The slow OOC Vivado synthesis is NOT redone per run: the netlist comes
    * from the cached `targets[<config>,<board>].oocNetlist`, which depends on
    * config + board only, so changing the model or the layer subset re-runs
    * just the xsim legs. Requires Vivado + xsim on PATH.
    *
    * @param args
    *   the layer subset, comma-separated, e.g.
    *   `QLinearConv1,MaxPool2,QLinearConv3`.
    */
  def postSynth(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val layers = args.value.headOption.getOrElse(
      sys.error("pass the layer subset, e.g. QLinearConv1,MaxPool2")
    )
    val compOut = compile().path
    val runDir = Task.dest / "postsynth"
    val tbDir = Task.dest / "vta-postsynth-tb"

    // The cached gate-level netlist for this (config, board).
    val netlist =
      build.targets(configKey, fpgaBoard).oocNetlist().path

    // The cached fsim per-layer dumps (input/output<layer>.bin). Read-only
    // here: the TB emitter reads input<layer>.bin, the compare stage reads
    // output<layer>.bin.
    val simOut = layerDumps().path

    // Emit the post-synth TB (hardware runner, config pinned via forkArgs like
    // runGenNnBaremetal does). simOutDir is where the TB reads the per-layer
    // input<layer>.bin dumps the fsim run above just wrote; without it the
    // emitter falls back to a stale relative default and cannot find them.
    hardware
      .runner()
      .run(
        args = Seq(
          tbDir.toString,
          s"--compilerOutDir=$compOut",
          s"--simOutDir=$simOut",
          s"--layers=$layers"
        ),
        mainClass = "vta.exporters.DefaultPynqConfigTbEmitter",
        forkArgs = Seq(s"-Dvta.config.file=$configKey.json"),
        workingDir = root
      )

    // Hand the inputs to the flow, which owns the stage sequencing and the
    // verdicts (propagateEnv so xsim sees XILINX_*).
    fpga.synthesis
      .runner()
      .run(
        args = Seq(
          "--board",
          fpgaBoard,
          "--netlist",
          netlist.toString,
          "--tb",
          tbDir.toString,
          "--comp-dir",
          compOut.toString,
          "--golden-dir",
          simOut.toString,
          "--out",
          runDir.toString,
          "--layers",
          layers
        ),
        mainClass = "fpga.synthesis.PostSynthFlow",
        workingDir = root,
        propagateEnv = true
      )
    PathRef(runDir)
  }
}

/** The whole per-(model, config) pipeline: compile, simulate, generate the
  * baremetal headers, create a Vitis workspace, check the gate-level netlist.
  *
  * Mix this in and supply `configKey`, `modelKey` and `onnxRoot`; everything
  * else follows. `VitisTasks` and `PostSynthTasks` between them already extend
  * the rest of the chain (BaremetalTasks -> LayerDumpTasks -> SimTasks ->
  * HasCompilableModel), so naming those two pulls in every task trait in this
  * file. `HasOnnxModel` is named on top because the simulator tasks hang off
  * the front-end agnostic `HasCompilableModel`: this is the pipeline for an
  * ONNX model, so it is what supplies the front end.
  */
trait VtaPipelineModule extends VitisTasks with PostSynthTasks with HasOnnxModel
