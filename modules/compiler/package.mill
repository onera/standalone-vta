package build.modules.compiler

import mill.*
import mill.api.Args
import mill.api.BuildCtx

/** The Python compiler: ONNX model -> VTA IR -> instruction/uop/data .bin
  * streams, plus the ONNX reference used to check simulator output.
  *
  * Needs a Python env with the compiler dependencies active on PATH. This
  * module holds no tasks of its own: it is the set of plain functions the
  * example pipelines call, through `examples.onnx[<model>,<config>].compile`
  * (both stages) and `examples.ir[<fixture>,<config>].compile` (vta_compiler
  * alone).
  */
object `package` extends Module { m =>

  /** Compiler source dirs whose content invalidates a compile.
    */
  def sources = Task.Sources(
    moduleDir / "nn_compiler",
    moduleDir / "vta_compiler",
    moduleDir / "reference_computation",
    moduleDir / "utils"
  )

  def nnCompilerMain = moduleDir / "nn_compiler" / "vta_backend.py"
  def vtaCompilerMain = moduleDir / "vta_compiler" / "main_vta_compiler.py"
  def referenceMain = moduleDir / "reference_computation" / "reference_onnx.py"
  def checkMain = moduleDir / "reference_computation" / "check_bin.py"
  def genIrInputsMain = moduleDir / "utils" / "gen_ir_inputs.py"
  def compareMain = moduleDir / "reference_computation" / "compare_bin.py"

  // Every stage resolves its output dir from VTA_COMPILER_OUT, so `dest` is
  // threaded through the environment (matching the Makefile and the scripts).
  private def envFor(env: Map[String, String], dest: os.Path) =
    env + ("VTA_COMPILER_OUT" -> dest.toString)

  /** The python the compiler stages run under: whatever is first on PATH.
    *
    * Activate your venv/pixi env before invoking Mill, or prefix the command
    * with `pixi run`.
    */
  def python = "python"

  def nnCompile(
    onnx: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): Unit =
    os.proc(python, nnCompilerMain, "--expand-bias", config, onnx)
      .call(
        cwd = BuildCtx.workspaceRoot,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  def vtaCompile(
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): Unit = {
    // The IR JSONs are already in `dest` - written there by [[nnCompile]] on
    // the ONNX path, or copied in by [[compileIr]] on the raw IR one. Resolve
    // the glob here rather than passing a pattern the shell would not expand.
    val irs = os.list(dest).filter(_.ext == "json").map(_.toString).sorted
    os.proc(python, vtaCompilerMain, "--summary", config, irs)
      .call(
        cwd = BuildCtx.workspaceRoot,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )
  }

  def runReference(
    onnx: os.Path,
    dest: os.Path,
    env: Map[String, String],
    refMode: String = "numpy",
    debug: String = "False"
  ): Unit =
    os.proc(python, referenceMain, debug, refMode, onnx)
      .call(
        cwd = BuildCtx.workspaceRoot,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  def runCheck(
    dest: os.Path,
    simDest: os.Path,
    env: Map[String, String],
    rtl: Boolean = false,
    debug: String = "False"
  ): Unit = {
    val extra = if (rtl) Seq("True") else Seq.empty[String]
    // The checker reads reference.bin from VTA_COMPILER_OUT and the simulator
    // result (final_output*.bin) from VTA_SIMULATOR_OUT.
    os.proc(python, checkMain, debug, extra)
      .call(
        cwd = BuildCtx.workspaceRoot,
        env = envFor(env, dest) + ("VTA_SIMULATOR_OUT" -> simDest.toString),
        stdout = os.Inherit,
        stderr = os.Inherit
      )
  }

  /** nn + vta - the compile shared by examples and the fpga goldens. */
  def compileModel(
    onnx: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): os.Path = {
    os.makeDir.all(dest)
    nnCompile(onnx, config, dest, env)
    vtaCompile(config, dest, env)
    dest
  }

  /** Generate the operands a raw VTA IR fixture declares, into `dest`. */
  def genIrInputs(
    ir: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): Unit =
    os.proc(python, genIrInputsMain, config, ir)
      .call(
        cwd = BuildCtx.workspaceRoot,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  /** Byte-compare two simulator outputs; throws when they differ. */
  def runCompare(a: os.Path, b: os.Path, env: Map[String, String]): Unit =
    os.proc(python, compareMain, a, b)
      .call(
        cwd = BuildCtx.workspaceRoot,
        env = env,
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  /** A raw VTA IR fixture compiled to .bin streams: copy the IR in, generate
    * its operands, then vta_compiler.
    *
    * The counterpart of compileModel for the front-endless path. No nn_compiler
    * and no reference: the fixture is already VTA IR, and nothing defines what
    * its output should be. The copy is what makes vtaCompile work, since that
    * globs the .json files in `dest`.
    */
  def compileIr(
    ir: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): os.Path = {
    os.makeDir.all(dest)
    os.copy.into(ir, dest, replaceExisting = true)
    genIrInputs(ir, config, dest, env)
    vtaCompile(config, dest, env)
    dest
  }

}
