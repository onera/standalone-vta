package build.vta

import mill._
import build.HasFpgaBoard
import build.HasVtaConfig
import mill.api.BuildCtx

/** The per-(model, config) pipeline, split by domain so a module can compose
  * the parts it needs instead of inheriting all of them.
  *
  * It lives in build.vta, above the four component packages it drives, because
  * nothing here is example-specific: any module supplying configKey, modelKey
  * and onnxRoot gets the pipeline, wherever its models live. examples/ is the
  * first consumer, not the owner. Being `vta/pipeline.mill` rather than a
  * `vta/pipeline/package.mill` is what keeps it out of the task graph: Mill
  * wraps a package.mill into a Module (so `vta.pipeline` would resolve as an
  * empty module) and every other .mill file into a plain object, which the
  * enclosing package then re-exports - hence `build.vta.VtaPipelineModule`.
  *
  * Traits only: Mill rejects a module or task defined outside a build.mill or
  * package.mill file, so the Cross objects stay in package.mill and this file
  * holds what they mix in.
  *
  * When a trait consumes a task that another trait here provides concretely, it
  * must EXTEND that trait rather than abstractly re-declare the task. Mill's
  * task macro reads a later abstract declaration of an already-concrete task as
  * an *override*: it emits `<task>.super.<Trait>` entries in `mill plan` and
  * relocates the task's real output to a `.super/<Trait>.dest` directory,
  * leaving the documented `<task>.dest` behind as a stale copy. The chain
  * HasOnnxModel <- SimTasks <- BaremetalTasks <- VitisTasks, and SimTasks <-
  * PostSynthTasks, is therefore load-bearing rather than stylistic. Abstract
  * declarations are fine only for what nothing here provides concretely
  * (configKey, modelKey, onnxRoot), satisfied by the leaf module.
  *
  * Every trait here that needs the config reaches it through HasVtaConfig alone
  * (directly, or transitively through another trait in this file), and the
  * board-dependent ones through HasFpgaBoard; both come from util.mill. None of
  * them mix in BaseVtaModule: it defines configKey and configSignature too, as
  * Tasks off the global -Dvta.config.file, and mixing both into one module is
  * an override conflict.
  */

/** An ONNX model and its compilation to VTA binaries. */
trait HasOnnxModel extends Module with HasVtaConfig {

  /** Directory the model files live in. */
  def onnxRoot: os.Path

  /** This model's name: `<onnxRoot>/<modelKey>.onnx`. */
  def modelKey: String

  def onnxDir = onnxRoot

  /** The ONNX model of this example, under examples/onnx. */
  def onnxPath = Task.Source(onnxDir / os.RelPath(s"$modelKey.onnx"))

  /** Compile this model for this config: nn_compiler, vta_compiler and the ONNX
    * reference.
    *
    * Writes the .bin / .csv streams to this task's dest. Cached: re-runs only
    * when the model, the config content or the compiler sources change.
    */
  def compile = Task {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    build.vta.compiler.sources() // invalidate on compiler-code change
    configSignature() // invalidate on config-content change
    val compOut = Task.dest
    build.vta.compiler
      .compileModel(
        python,
        root,
        onnxPath().path,
        configPath,
        compOut,
        Task.env
      )
    build.vta.compiler
      .runReference(python, root, onnxPath().path, compOut, Task.env)
    PathRef(compOut)
  }
}

/** Functional and Verilated RTL simulation of a compiled model. */
trait SimTasks extends HasOnnxModel {

  private def funcsimStage(
    python: os.Path,
    root: os.Path,
    compOut: os.Path,
    simOut: os.Path,
    fsim: os.Path,
    fsimFlags: Seq[String],
    env: Map[String, String]
  ): Unit = {
    build.vta
      .simulator(configKey)
      .launchSim(
        fsim,
        Seq("--comp-dir", compOut.toString, "--output", simOut.toString)
          ++ fsimFlags,
        root,
        env
      )
    build.vta.compiler.runCheck(python, root, compOut, simOut, env)
  }

  private def verilatorSimStage(
    python: os.Path,
    root: os.Path,
    compOut: os.Path,
    simOut: os.Path,
    vsim: os.Path,
    vsimFlags: Seq[String],
    env: Map[String, String]
  ): Unit = {
    build.vta
      .simulator(configKey)
      .launchSim(
        vsim,
        Seq("--comp-dir", compOut.toString, "--output", simOut.toString)
          ++ vsimFlags,
        root,
        env
      )
    build.vta.compiler.runCheck(python, root, compOut, simOut, env, rtl = true)
  }

  /** fsim -> check -> vsim -> check against an already-compiled compiler_output
    * dir, writing the simulator results to simOut. Never invokes the Python
    * compiler.
    */
  private def simStage(
    python: os.Path,
    root: os.Path,
    compOut: os.Path,
    simOut: os.Path,
    fsim: os.Path,
    fsimFlags: Seq[String],
    vsim: os.Path,
    vsimFlags: Seq[String],
    env: Map[String, String]
  ): Unit = {
    funcsimStage(python, root, compOut, simOut, fsim, fsimFlags, env)
    verilatorSimStage(python, root, compOut, simOut, vsim, vsimFlags, env)
  }

  /** Full cached validation of this example: compile, then functional (fsim)
    * and Verilated RTL (vsim) simulation, each checked against the ONNX
    * reference.
    *
    * Re-runs only when the compile inputs or the simulator binaries change; use
    * [[run]] to force a fresh simulation.
    */
  def outputs = Task {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val fsim = build.vta.simulator(configKey).fsimBinary().path
    val vsim = build.vta.simulator(configKey).vsimBinary().path
    BuildCtx.withFilesystemCheckerDisabled {
      simStage(
        python,
        root,
        compOut,
        Task.dest,
        fsim,
        Seq(),
        vsim,
        Seq(),
        Task.env
      )
      PathRef(compOut)
    }
  }

  /** Run the functional (C++) simulator on this example and check its output
    * against the ONNX reference.
    *
    * Compiles the model first if stale. Always simulates, so it is the task to
    * use when passing flags.
    *
    * @param args
    *   extra flags forwarded to the fsim binary, e.g. `--layer 3 --verbose` to
    *   run and print a single VTA layer.
    */
  def fsim(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val fsim = build.vta.simulator(configKey).fsimBinary().path
    funcsimStage(python, root, compOut, Task.dest, fsim, args.value, Task.env)
    PathRef(Task.dest)
  }

  /** Run the Verilated RTL (Chisel) simulator on this example and check its
    * output against the ONNX reference.
    *
    * Compiles the model first if stale, and rebuilds the RTL/vsim binary if the
    * hardware changed. Always simulates.
    *
    * @param args
    *   extra flags forwarded to the vsim binary, e.g. `--no-timeout`, `--trace`
    *   (waveform per layer), `--layer 3`, `--dump-layers`.
    */
  def vsim(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val vsim = build.vta.simulator(configKey).vsimBinary().path
    verilatorSimStage(
      python,
      root,
      compOut,
      Task.dest,
      vsim,
      args.value,
      Task.env
    )
    PathRef(Task.dest)
  }

  /** Run this example end to end: fsim and vsim, each checked against the ONNX
    * reference.
    *
    * Same coverage as [[outputs]] but always simulates (compilation is still
    * cached). vsim is given --no-timeout.
    *
    * @param args
    *   extra flags forwarded to both simulator binaries, e.g. `--layer 3
    *   --verbose`.
    */
  def run(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val fsim = build.vta.simulator(configKey).fsimBinary().path
    val vsim = build.vta.simulator(configKey).vsimBinary().path
    simStage(
      python,
      root,
      compOut,
      Task.dest,
      fsim,
      args.value,
      vsim,
      "--no-timeout" +: args.value,
      Task.env
    )
    PathRef(Task.dest)
  }

  /** Per-layer fsim golden dumps for this example: input<suffix>.bin and
    * output<suffix>.bin in this task's dest.
    *
    * The reference set the on-board isolation runners and the post-synth
    * compare check against. Compiles the model first if stale; cached, so the
    * dump is shared by [[genBaremetalDebug]] and [[postSynth]].
    */
  def layerDumps = Task {
    val compOut = compile().path
    val fsim = build.vta.simulator(configKey).fsimBinary().path
    build.vta
      .simulator(configKey)
      .launchSim(
        fsim,
        Seq(
          "--comp-dir",
          compOut.toString,
          "--output",
          Task.dest.toString,
          "--dump-layers"
        ),
        BuildCtx.workspaceRoot,
        Task.env
      )
    PathRef(Task.dest)
  }
}

/** Baremetal PS codegen and the SD-card file sets. */
trait BaremetalTasks extends SimTasks {

  /** DDR base address used by the baremetal codegen, from -Dvta.ddr.base
    * (default 0x0). Must match the board's DDR base, e.g. 0x10000000.
    *
    * Duplicates BaseVtaModule's task of the same name, which this trait cannot
    * mix in (see the file header); the default itself is shared.
    */
  def vtaDdrBase = Task.Input {
    sys.props.getOrElse("vta.ddr.base", build.defaultDdrBase)
  }

  /** SD-card subfolder this model's files live in: the model name, so several
    * models can share one card (`0:/<model>/instructions_L0.bin`). Emitted into
    * nn_sd_manifest.h as NN_SD_DIR.
    */
  def sdDir: String = modelKey

  /** Generate the baremetal PS headers (nn_exec_plan.h, nn_ddr_map.h, ...) for
    * this example into this task's dest.
    *
    * Compiles the model first if stale. No Vivado needed. Cached: re-runs when
    * the compile inputs, the config or -Dvta.ddr.base change. The SD manifest
    * is always emitted (so `--data-loader sd` builds) but nothing is staged -
    * use [[sdCard]] for the copy-to-card file set.
    */
  // Writes into this task's dest, never the tracked vta/fpga/software/gen/ dir
  // that a Vitis build reads from: a cached task must not silently overwrite it.
  def genBaremetal = Task {
    val compOut = compile().path
    build.vta.fpga.software.runGenNnBaremetal(
      build.vta.fpga.software.runner(),
      compOut,
      Task.dest,
      configKey,
      vtaDdrBase(),
      Seq("--emit-sd-manifest", "--no-stage-sd-files", "--sd-dir", sdDir)
    )
    PathRef(Task.dest)
  }

  /** Stage this example's SD-card file set: the .bin streams the runtime `sd`
    * loader reads, under `<dest>/sd_card/<model>/`.
    *
    * Re-runs the codegen with staging enabled into its own dest; the layout is
    * deterministic, so the addresses match the app built from [[genBaremetal]].
    * Not used by the Vitis tasks - it only produces files to copy to a FAT32
    * card. For the isolation runners use [[sdCardDebug]], which also stages the
    * goldens.
    */
  def sdCard() = Task.Command {
    val compOut = compile().path
    build.vta.fpga.software.runGenNnBaremetal(
      build.vta.fpga.software.runner(),
      compOut,
      Task.dest,
      configKey,
      vtaDdrBase(),
      Seq("--emit-sd-manifest", "--sd-dir", sdDir)
    )
    println(s"[INFO] copy ${Task.dest / "sd_card" / sdDir} to the SD card root")
    PathRef(Task.dest / "sd_card")
  }

  /** Baremetal PS headers for the on-board isolation runners: [[genBaremetal]]
    * plus nn_debug_map.h and nn_cpu_debug_map.h, wired to this example's fsim
    * goldens ([[layerDumps]]).
    *
    * Cached like [[genBaremetal]], with the golden dump as an extra input. One
    * gen dir serves both run_nn_debug and run_nn_cpu_debug: --emit-cpu-check
    * only adds a header, it changes no DDR layout.
    */
  def genBaremetalDebug = Task {
    val compOut = compile().path
    build.vta.fpga.software.runGenNnBaremetal(
      build.vta.fpga.software.runner(),
      compOut,
      Task.dest,
      configKey,
      vtaDdrBase(),
      Seq(
        "--emit-sd-manifest",
        "--no-stage-sd-files",
        "--sd-dir",
        sdDir,
        "--emit-layer-check",
        "--emit-cpu-check",
        "--ref-dir",
        layerDumps().path.toString
      )
    )
    PathRef(Task.dest)
  }

  /** Stage the SD-card file set for the isolation runners: the model .bin
    * streams *and* the per-layer goldens, under `<dest>/sd_card/<model>/`.
    *
    * What `createVitisDebugProject --data-loader sd` needs on the card; the
    * plain [[sdCard]] set has no references and cannot drive a debug run.
    */
  def sdCardDebug() = Task.Command {
    val compOut = compile().path
    build.vta.fpga.software.runGenNnBaremetal(
      build.vta.fpga.software.runner(),
      compOut,
      Task.dest,
      configKey,
      vtaDdrBase(),
      Seq(
        "--emit-sd-manifest",
        "--sd-dir",
        sdDir,
        "--emit-layer-check",
        "--emit-cpu-check",
        "--ref-dir",
        layerDumps().path.toString
      )
    )
    println(s"[INFO] copy ${Task.dest / "sd_card" / sdDir} to the SD card root")
    PathRef(Task.dest / "sd_card")
  }
}

/** Vitis workspace and application creation. */
trait VitisTasks extends BaremetalTasks with HasFpgaBoard {

  /** Add this example's app components to the shared Vitis workspace of its
    * (config, board), ready to build and flash.
    *
    * The workspace and its hardware platform are per (config, board) only -
    * `vta.fpga.targets[<config>,<board>].vitisPlatform`, built first if stale
    * (which synthesizes the XSA if needed). This task adds the model-dependent
    * part on top: app components named `<model>_<runner>[_<loader>]`, wired to
    * this example's generated headers ([[genBaremetal]]). Several models
    * therefore coexist in one workspace per platform. Requires Vivado and
    * Vitis.
    *
    * The board comes from -Dvta.board.name (default zcu104).
    *
    * @param args
    *   extra flags forwarded to create_vitis_workspace.py, e.g. `--runner
    *   <app>`, `--data-loader sd`.
    */
  def createVitisProject(args: Args) = Task.Command {
    val genDir = genBaremetal().path
    val ws =
      os.Path(build.vta.fpga.targets(configKey, fpgaBoard).vitisPlatform())
    val manifest = build.vta.fpga
      .targets(configKey, fpgaBoard)
      .fpgaSynth()
      .path / "manifest.json"
    build.vta.fpga.software.runCreateVitisApps(
      Task.env,
      build.vta.fpga.software.vitisScript().path,
      build.vta.fpga.readManifestField(manifest, "cpu"),
      Some(genDir),
      ws,
      modelKey,
      args.value
    )
    ws.toString
  }

  /** Create a Vitis workspace for this example from an XSA you already have,
    * with no Vivado run at all.
    *
    * The synthesis-driven path is [[createVitisProject]]; this command shares
    * only the generated headers ([[genBaremetal]]) with it. Mill fills in just
    * what it knows - the workspace dir, this model's headers and the app-name
    * prefix - and each can be overridden by repeating the flag in `args`, since
    * the script keeps the last occurrence. The workspace defaults to
    * `build/vitis/<model>_<config>` so a rerun reuses the platform it built.
    *
    * @param args
    *   create_vitis_workspace.py flags. `--xsa <file>` is required; typically
    *   also `--runner run_nn`, `--data-loader elf`, and `--cpu <name>` for a
    *   non-ZynqMP board (default psu_cortexa53_0).
    */
  def createVitisProjectFromXsa(args: Args) = Task.Command {
    val genDir = genBaremetal().path
    val ws = BuildCtx.workspaceRoot / "build" / "vitis" /
      s"${modelKey}_$configKey"
    build.vta.fpga.execVitis(
      Task.env,
      Seq(
        "-s",
        build.vta.fpga.software.vitisScript().path.toString,
        "--workspace",
        ws.toString,
        "--gen-dir",
        genDir.toString,
        "--name-prefix",
        modelKey
      ) ++ args.value
    )
    ws.toString
  }

  /** Add this example's on-board isolation app to the shared Vitis workspace of
    * its (config, board): fsim goldens, debug headers and app in one step.
    *
    * Same workspace and platform as [[createVitisProject]] (so it synthesizes
    * if stale), but the app is wired to [[genBaremetalDebug]]. Defaults to
    * `--runner run_nn_debug --data-loader elf`, emitted *before* the forwarded
    * args so a later value overrides them (argparse keeps the last occurrence).
    *
    * @param args
    *   extra flags for create_vitis_workspace.py, e.g. `--runner
    *   run_nn_cpu_debug`, `--data-loader sd` (stage the card with
    *   [[sdCardDebug]] first), `--pl-reset-between-layers`.
    */
  def createVitisDebugProject(args: Args) = Task.Command {
    val genDir = genBaremetalDebug().path
    val ws =
      os.Path(build.vta.fpga.targets(configKey, fpgaBoard).vitisPlatform())
    val manifest = build.vta.fpga
      .targets(configKey, fpgaBoard)
      .fpgaSynth()
      .path / "manifest.json"
    build.vta.fpga.software.runCreateVitisApps(
      Task.env,
      build.vta.fpga.software.vitisScript().path,
      build.vta.fpga.readManifestField(manifest, "cpu"),
      Some(genDir),
      ws,
      modelKey,
      Seq("--runner", "run_nn_debug", "--data-loader", "elf") ++ args.value
    )
    ws.toString
  }
}

/** Post-synthesis gate-level checking. */
trait PostSynthTasks extends SimTasks with HasFpgaBoard {

  /** End-to-end post-synthesis gate-level check for this example on the active
    * board (-Dvta.board.name): compile the model, dump the per-layer fsim
    * goldens, emit the post-synth TB, run xsim behavioral + netlist against the
    * cached gate-level netlist, and strb-compare the netlist OUT to the golden.
    * All artifacts land under this task's dest.
    *
    * The slow OOC Vivado synthesis is NOT redone per run: the netlist comes
    * from the cached `vta.fpga.targets[<config>,<board>].oocNetlist`, which
    * depends on config + board only, so changing the model or the layer subset
    * re-runs just the xsim legs. Requires Vivado + xsim on PATH.
    *
    * @param args
    *   the layer subset, comma-separated, e.g.
    *   `QLinearConv1,MaxPool2,QLinearConv3`.
    */
  def postSynth(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val layers = args.value.headOption.getOrElse(
      sys.error("pass the layer subset, e.g. QLinearConv1,MaxPool2")
    )
    val compOut = compile().path
    val runDir = Task.dest / "postsynth"
    val tbDir = Task.dest / "vta-postsynth-tb"

    // The cached gate-level netlist for this (config, board).
    val netlist = build.vta.fpga.targets(configKey, fpgaBoard).oocNetlist().path

    // The cached fsim per-layer dumps (input/output<layer>.bin). Read-only
    // here: the TB emitter reads input<layer>.bin, the compare stage reads
    // output<layer>.bin.
    val simOut = layerDumps().path

    // Emit the post-synth TB (hardware runner, config pinned via forkArgs like
    // runGenNnBaremetal does). simOutDir is where the TB reads the per-layer
    // input<layer>.bin dumps the fsim run above just wrote; without it the
    // emitter falls back to a stale relative default and cannot find them.
    build.vta.hardware
      .runner()
      .run(
        args = Seq(
          tbDir.toString,
          s"--compilerOutDir=$compOut",
          s"--simOutDir=$simOut",
          s"--layers=$layers"
        ),
        mainClass = "vta.exporters.DefaultPynqConfigTbEmitter",
        forkArgs = Seq(s"-Dvta.config.file=$configKey.json"),
        workingDir = root
      )

    // Hand the inputs to the flow, which owns the stage sequencing and the
    // verdicts (propagateEnv so xsim sees XILINX_*).
    build.vta.fpga.synthesis
      .runner()
      .run(
        args = Seq(
          "--board",
          fpgaBoard,
          "--netlist",
          netlist.toString,
          "--tb",
          tbDir.toString,
          "--comp-dir",
          compOut.toString,
          "--golden-dir",
          simOut.toString,
          "--out",
          runDir.toString,
          "--layers",
          layers
        ),
        mainClass = "fpga.synthesis.PostSynthFlow",
        workingDir = root,
        propagateEnv = true
      )
    PathRef(runDir)
  }
}

/** The whole per-(model, config) pipeline: compile, simulate, generate the
  * baremetal headers, create a Vitis workspace, check the gate-level netlist.
  *
  * Mix this in and supply `configKey`, `modelKey` and `onnxRoot`; everything
  * else follows. `VitisTasks` and `PostSynthTasks` between them already extend
  * the rest of the chain, so naming those two composes all six.
  */
trait VtaPipelineModule extends VitisTasks with PostSynthTasks
