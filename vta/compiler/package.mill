package build.vta.compiler

import mill.*, pythonlib.*
import mill.api.Args
import mill.api.BuildCtx

trait CompilerPythonModule extends PythonModule {

  private def onPath(path: String, exe: String): Option[String] =
    path
      .split(java.io.File.pathSeparatorChar)
      .iterator
      .filter(_.nonEmpty)
      .map(d => java.nio.file.Paths.get(d, exe))
      .find(java.nio.file.Files.isExecutable)
      .map(_.toString)

  override def pythonExe = Task.Source {
    val env = Task.env
    val python = onPath(env.getOrElse("PATH", ""), "python3")
      .getOrElse(sys.error("python3 not found on PATH"))
    os.Path(python)
  }

}
object `package` extends CompilerPythonModule { m =>

  /** Narrow code sources - the single source-of-truth for "what invalidates a
    * compile". Deliberately excludes .venv and the legacy uv pins.
    */
  def sources = Task.Sources(
    moduleDir / "nn_compiler",
    moduleDir / "vta_compiler",
    moduleDir / "reference_computation",
    moduleDir / "utils"
  )

  def nnCompilerMain = moduleDir / "nn_compiler" / "vta_backend.py"
  def vtaCompilerMain = moduleDir / "vta_compiler" / "main_vta_compiler.py"
  def referenceMain = moduleDir / "reference_computation" / "reference_onnx.py"
  def checkMain = moduleDir / "reference_computation" / "check_bin.py"

  // Every stage resolves its output dir from VTA_COMPILER_OUT, so `dest` is
  // threaded through the environment (matching the Makefile and the scripts).
  private def envFor(env: Map[String, String], dest: os.Path) =
    env + ("VTA_COMPILER_OUT" -> dest.toString)

  def runNn(
    python: os.Path,
    root: os.Path,
    onnx: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): Unit =
    os.proc(python, nnCompilerMain, "--debug", "--expand-bias", config, onnx)
      .call(
        cwd = root,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  def runVta(
    python: os.Path,
    root: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): Unit = {
    // The IR JSONs are produced by runNn into `dest`; resolve the glob here.
    val irs = os.list(dest).filter(_.ext == "json").map(_.toString).sorted
    os.proc(python, vtaCompilerMain, "--summary", config, irs)
      .call(
        cwd = root,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )
  }

  def runReference(
    python: os.Path,
    root: os.Path,
    onnx: os.Path,
    dest: os.Path,
    env: Map[String, String],
    refMode: String = "numpy",
    debug: String = "False"
  ): Unit =
    os.proc(python, referenceMain, debug, refMode, onnx)
      .call(
        cwd = root,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  def runCheck(
    python: os.Path,
    root: os.Path,
    dest: os.Path,
    env: Map[String, String],
    rtl: Boolean = false,
    debug: String = "False"
  ): Unit = {
    val extra = if (rtl) Seq("True") else Seq.empty[String]
    os.proc(python, checkMain, debug, extra)
      .call(
        cwd = root,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )
  }

  /** nn + vta - the compile shared by examples and the fpga goldens. */
  def compileModel(
    python: os.Path,
    root: os.Path,
    onnx: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): os.Path = {
    os.makeDir.all(dest)
    runNn(python, root, onnx, config, dest, env)
    runVta(python, root, config, dest, env)
    dest
  }

  /** Standalone compile: `./mill "vta.compiler.compile <config> <onnx>"`.
    * Output dir comes from VTA_COMPILER_OUT, else repo-root compiler_output.
    */
  def compile(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val cfg :: onnx :: Nil = args.value.take(2).toList: @unchecked
    val dest = os.Path(
      Task.env
        .getOrElse("VTA_COMPILER_OUT", (root / "compiler_output").toString)
    )
    compileModel(
      pythonExe().path,
      root,
      os.Path(onnx, root),
      os.Path(cfg, root),
      dest,
      Task.env
    )
    println(s"[INFO] compiled $onnx into $dest")
  }
}
