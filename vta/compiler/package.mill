package build.vta.compiler

import mill.*, pythonlib.*
import mill.api.Args
import mill.api.BuildCtx

trait CompilerPythonModule extends PythonModule {

  private val pythonNames: Seq[String] =
    if (scala.util.Properties.isWin) Seq("python3.exe", "python.exe")
    else Seq("python3", "python")

  private def onPath(path: String, names: Seq[String]): Option[String] =
    path
      .split(java.io.File.pathSeparatorChar)
      .iterator
      .filter(_.nonEmpty)
      .flatMap(d => names.iterator.map(n => java.nio.file.Paths.get(d, n)))
      .find(java.nio.file.Files.isExecutable)
      .map(_.toString)

  /** The python3 interpreter used for every compiler stage: the first one on
    * PATH, so activate your venv/pixi env before invoking Mill.
    */
  override def pythonExe = Task.Source {
    val env = Task.env
    val python = onPath(env.getOrElse("PATH", ""), pythonNames)
      .getOrElse(
        sys.error(s"none of ${pythonNames.mkString(", ")} found on PATH")
      )
    os.Path(python)
  }

}

/** The Python compiler: ONNX model -> VTA IR -> instruction/uop/data .bin
  * streams, plus the ONNX reference used to check simulator output.
  *
  * Needs a Python env with the compiler dependencies active on PATH. Examples
  * call these stages through `examples[<model>,<config>].compile`; use
  * [[compile]] here to compile an arbitrary model by hand.
  */
object `package` extends CompilerPythonModule { m =>

  /** Compiler source dirs whose content invalidates a compile (excludes .venv
    * and the legacy uv pins).
    */
  def sources = Task.Sources(
    moduleDir / "nn_compiler",
    moduleDir / "vta_compiler",
    moduleDir / "reference_computation",
    moduleDir / "utils"
  )

  def nnCompilerMain = moduleDir / "nn_compiler" / "vta_backend.py"
  def vtaCompilerMain = moduleDir / "vta_compiler" / "main_vta_compiler.py"
  def referenceMain = moduleDir / "reference_computation" / "reference_onnx.py"
  def checkMain = moduleDir / "reference_computation" / "check_bin.py"

  // Every stage resolves its output dir from VTA_COMPILER_OUT, so `dest` is
  // threaded through the environment (matching the Makefile and the scripts).
  private def envFor(env: Map[String, String], dest: os.Path) =
    env + ("VTA_COMPILER_OUT" -> dest.toString)

  def nnCompile(
    python: os.Path,
    root: os.Path,
    onnx: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): Unit =
    os.proc(python, nnCompilerMain, "--expand-bias", config, onnx)
      .call(
        cwd = root,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  def vtaCompile(
    python: os.Path,
    root: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): Unit = {
    // The IR JSONs are produced by runNn into `dest`; resolve the glob here.
    val irs = os.list(dest).filter(_.ext == "json").map(_.toString).sorted
    os.proc(python, vtaCompilerMain, "--summary", config, irs)
      .call(
        cwd = root,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )
  }

  def runReference(
    python: os.Path,
    root: os.Path,
    onnx: os.Path,
    dest: os.Path,
    env: Map[String, String],
    refMode: String = "numpy",
    debug: String = "False"
  ): Unit =
    os.proc(python, referenceMain, debug, refMode, onnx)
      .call(
        cwd = root,
        env = envFor(env, dest),
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  def runCheck(
    python: os.Path,
    root: os.Path,
    dest: os.Path,
    simDest: os.Path,
    env: Map[String, String],
    rtl: Boolean = false,
    debug: String = "False"
  ): Unit = {
    val extra = if (rtl) Seq("True") else Seq.empty[String]
    // The checker reads reference.bin from VTA_COMPILER_OUT and the simulator
    // result (final_output*.bin) from VTA_SIMULATOR_OUT.
    os.proc(python, checkMain, debug, extra)
      .call(
        cwd = root,
        env = envFor(env, dest) + ("VTA_SIMULATOR_OUT" -> simDest.toString),
        stdout = os.Inherit,
        stderr = os.Inherit
      )
  }

  /** nn + vta - the compile shared by examples and the fpga goldens. */
  def compileModel(
    python: os.Path,
    root: os.Path,
    onnx: os.Path,
    config: os.Path,
    dest: os.Path,
    env: Map[String, String]
  ): os.Path = {
    os.makeDir.all(dest)
    nnCompile(python, root, onnx, config, dest, env)
    vtaCompile(python, root, config, dest, env)
    dest
  }

  /** Compile one ONNX model for one config, outside the examples cross module:
    * `./mill vta.compiler.compile <config.json> <model.onnx>`.
    *
    * Runs nn_compiler then vta_compiler. Writes to $VTA_COMPILER_OUT, or to
    * compiler_output/ at the repo root when that is unset. Uncached.
    *
    * @param config
    *   the config JSON path (relative to the repo root or absolute)
    * @param onnx
    *   the ONNX model path.
    */
  def compile(config: String, onnx: String) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val dest = os.Path(
      Task.env
        .getOrElse("VTA_COMPILER_OUT", (root / "compiler_output").toString)
    )
    compileModel(
      pythonExe().path,
      root,
      os.Path(onnx, root),
      os.Path(config, root),
      dest,
      Task.env
    )
    println(s"[INFO] compiled $onnx into $dest")
  }
}
