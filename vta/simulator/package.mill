package build.vta.simulator

import mill.*
import mill.api.BuildCtx

trait ConfigModule extends build.ConfigCrossModule {

  /** C++/Verilator source dirs whose content triggers a simulator rebuild
    * (narrow, so the .d/.o artefacts under build/ never feed back in).
    */
  def simSources = Task.Sources(
    moduleDir / "src",
    moduleDir / "include",
    moduleDir / "config",
    moduleDir / "external_lib",
    moduleDir / "Makefile"
  )

  /** Shared body for fsimBinary/vsimBinary (flat, global-prop-driven) and
    * configs[X]'s versions (cross-value-driven): build via make into a
    * per-config dir. Parameterized by configPath/configKey instead of reading
    * BaseVtaModule's global vtaConfigPath()/configKey() directly, so the same
    * logic serves both entry points without duplication.
    */
  def buildSim(
    configPath: os.Path,
    configKey: String,
    dest: os.Path,
    env: Map[String, String],
    binaryName: String,
    extraMakeArgs: Seq[String]
  ): PathRef = {
    os.proc(
      "make",
      s"CONFIG=$configPath",
      s"BUILD_DIR=$dest/$configKey",
      extraMakeArgs,
      s"compile-$binaryName"
    ).call(cwd = moduleDir, env = env, stdout = os.Inherit, stderr = os.Inherit)
    BuildCtx.withFilesystemCheckerDisabled {
      PathRef(dest / configKey / binaryName)
    }
  }

  /** Build the functional simulator for this config and return the fsim binary.
    * See vta.simulator.fsimBinary.
    */
  def fsimBinary = Task {
    simSources()
    configSignature()
    buildSim(configPath, configKey, Task.dest, Task.env, "fsim", Seq())
  }

  /** Build the Verilated RTL simulator for this config and return the vsim
    * binary. See vta.simulator.vsimBinary.
    */
  def vsimBinary = Task {
    simSources()
    configSignature()
    val shellDir = build.vta.hardware.configs(configKey).vtaSimConfig().path
    buildSim(
      configPath,
      configKey,
      Task.dest,
      Task.env,
      "vsim",
      Seq(s"VTASHELL_DIR=$shellDir")
    )
  }

  /** Launch a built simulator binary directly (this is the "run in Mill, not
    * make" path). Callers pass --comp-dir and any runtime flags. Shared by the
    * functional (fsim) and Verilated (vsim) paths - both just exec a binary.
    */
  def launchSim(
    binary: os.Path,
    flags: Seq[String],
    cwd: os.Path,
    env: Map[String, String]
  ) =
    os.proc(binary, flags).call(env = env, cwd = cwd, stdout = os.Inherit)

  def launchFSim(args: Args) = Task.Anon{
    os.proc(fsimBinary().path,args.value).call(cwd = BuildCtx.workspaceRoot,env = Task.env,stdout = os.Inherit) 
  }
  def launchVSim(args: Args) = Task.Anon {
    os.proc(vsimBinary().path,args.value).call(cwd = BuildCtx.workspaceRoot,env = Task.env,stdout = os.Inherit) 
  }

  /** Build the functional simulator for the active config and launch it on an
    * already-compiled model. No compile, no reference check.
    *
    * @param args
    *   flags for the fsim binary, e.g. `--comp-dir <compiler_output> --layer 3
    *   --verbose`. Defaults to compiler_output/ at the repo root.
    */
  def fsim(args: Args) = Task.Command {launchFSim(args)()}

  /** Build the Verilated RTL simulator for the active config and launch it on
    * an already-compiled model. No compile, no reference check.
    *
    * @param args
    *   flags for the vsim binary, e.g. `--comp-dir <compiler_output>
    *   --no-timeout --trace`. Defaults to compiler_output/ at the repo root.
    */
  def vsim(args: Args) = Task.Command (launchVSim(args)())
}

/** The two C++ simulators: fsim (fast functional model) and vsim (the Chisel
  * RTL, Verilated), both built per config.
  *
  * Tasks here build and launch a simulator against any compiler_output dir; to
  * simulate an example model end to end (compile + check included), use
  * `examples[<model>,<config>].fsim` / `.vsim` instead.
  */
object `package`
    extends build.BaseVtaModule
    with Cross[ConfigModule](build.configNames)
