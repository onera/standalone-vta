package build.vta.simulator

import mill.*
import mill.api.BuildCtx

trait ConfigModule extends build.ConfigCrossModule {

  /** C++/Verilator source dirs whose content triggers a simulator rebuild
    * (narrow, so the .d/.o artefacts under build/ never feed back in).
    */
  def simSources = Task.Sources(
    moduleDir / "src",
    moduleDir / "include",
    moduleDir / "config",
    moduleDir / "external_lib",
    moduleDir / "Makefile"
  )

  /** Shared body for [[fsimBinary]] and [[vsimBinary]]: build via make into a
    * per-config dir. The config comes from this instance's cross value, so the
    * two differ only by the binary they ask make for and the extra make args.
    */
  private def buildSim(
    dest: os.Path,
    env: Map[String, String],
    binaryName: String,
    extraMakeArgs: Seq[String]
  ): PathRef = {
    os.proc(
      "make",
      s"CONFIG=$configPath",
      s"BUILD_DIR=$dest",
      extraMakeArgs,
      s"compile-$binaryName"
    ).call(cwd = moduleDir, env = env, stdout = os.Inherit, stderr = os.Inherit)
    BuildCtx.withFilesystemCheckerDisabled {
      PathRef(dest / binaryName)
    }
  }

  /** Build the functional (C++ model) simulator for this config and return the
    * fsim binary.
    *
    * Cached: re-runs when the simulator sources or the config content change.
    * Needs no Chisel RTL.
    */
  def fsimBinary = Task {
    simSources()
    configSignature()
    buildSim(Task.dest, Task.env, "fsim", Seq())
  }

  /** Build the Verilated RTL simulator for this config and return the vsim
    * binary.
    *
    * Verilates the VTAShell.sv that vta.hardware.configs[<config>] emits, so a
    * Chisel change rebuilds it. Cached like [[fsimBinary]] otherwise.
    */
  def vsimBinary = Task {
    simSources()
    configSignature()
    val shellDir = build.vta.hardware.configs(configKey).vtaSimConfig().path
    buildSim(Task.dest, Task.env, "vsim", Seq(s"VTASHELL_DIR=$shellDir"))
  }

  /** Launch a built simulator binary directly (this is the "run in Mill, not
    * make" path). Callers pass --comp-dir and any runtime flags. Shared by the
    * functional (fsim) and Verilated (vsim) paths - both just exec a binary.
    */
  // stderr is inherited alongside stdout, like every build.vta.compiler stage:
  // otherwise a simulator warning is captured and only ever resurfaces inside
  // the exception message of a run that failed.
  def launchSim(binary: os.Path, flags: Seq[String], env: Map[String, String]) =
    os.proc(binary, flags)
      .call(
        env = env,
        cwd = BuildCtx.workspaceRoot,
        stdout = os.Inherit,
        stderr = os.Inherit
      )

  /** Build the functional simulator for the active config and launch it on an
    * already-compiled model. No compile, no reference check.
    *
    * @param args
    *   flags for the fsim binary, e.g. `--comp-dir <compiler_output> --layer 3
    *   --verbose`. Defaults to compiler_output/ at the repo root.
    */
  def fsim(args: Args) = Task.Command {
    launchSim(fsimBinary().path, args.value, Task.env)
  }

  /** Build the Verilated RTL simulator for the active config and launch it on
    * an already-compiled model. No compile, no reference check.
    *
    * @param args
    *   flags for the vsim binary, e.g. `--comp-dir <compiler_output>
    *   --no-timeout --trace`. Defaults to compiler_output/ at the repo root.
    */
  def vsim(args: Args) = Task.Command {
    launchSim(vsimBinary().path, args.value, Task.env)
  }
}

/** The two C++ simulators: fsim (fast functional model) and vsim (the Chisel
  * RTL, Verilated), both built per config.
  *
  * Tasks here build and launch a simulator against any compiler_output dir; to
  * simulate an example model end to end (compile + check included), use
  * `examples.onnx[<model>,<config>].fsim` / `.vsim` instead.
  */
object `package` extends Module with Cross[ConfigModule](build.configNames)
