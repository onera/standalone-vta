package build.vta.hardware

import mill._
import mill.javalib._
import mill.javalib.publish._
import mill.javalib.TestModule.ScalaTest
import mill.api.Task.Simple
import mill.api.BuildCtx
import mill.javalib.testrunner.TestResult

/** The VTA hardware itself: the Chisel RTL, its ScalaTest cycle-accurate tests,
  * and the SystemVerilog emitters.
  *
  * The emit tasks turn the active config into RTL - for the Verilated simulator
  * (vta.simulator) or for the Xilinx IP flow (vta.fpga).
  */
object `package` extends build.VtaScalaModule with PublishModule { m =>

  def artifactName = "vta-standalone"

  def javacOptions = Seq("--release", "8")

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-Xcheckinit",
    "-language:reflectiveCalls",
    "-Ymacro-annotations",
    "-Wunused",
    "-release:8"
  )

  override def mainClass: Simple[Option[String]] = Some("cli.VTAShellSimulator")

  def chiselVersion = "7.11.0"

  def mvnDeps = Seq(
    mvn"com.fasterxml.jackson.core:jackson-databind:2.21.0",
    mvn"com.fasterxml.jackson.module::jackson-module-scala:2.21.0",
    mvn"net.java.dev.jna:jna:5.18.0",
    mvn"org.chipsalliance::chisel:${chiselVersion}",
    mvn"edu.berkeley.cs::chiseltest:6.0.0",
    mvn"org.scalatest::scalatest:3.2.19",
    mvn"com.github.scopt::scopt:4.1.0"
  )
  override def scalacPluginMvnDeps: Simple[Seq[Dep]] = Seq(
    mvn"org.chipsalliance:::chisel-plugin:${chiselVersion}"
  )

  def pomSettings = PomSettings(
    "vta-standalone",
    "edu.berkeley.cs",
    "",
    Seq(),
    VersionControl(
      Some("https://github.com/onera/standalone-vta"),
      Some("scm:git:https://github.com/onera/standalone-vta.git"),
      Some("scm:git:git@github.com:onera/standalone-vta.git"),
      None
    ),
    Seq()
  )

  def publishVersion = "6.0-SNAPSHOT"

  /** Content hash of the active config JSON, for the emit tasks below.
    *
    * None when the name does not resolve under config/ (e.g. a resource-based
    * test config).
    */
  // Needed because the forked emit JVM only receives the config *filename* (via
  // forkArgs -Dvta.config.file): without this, editing the file in place would
  // not invalidate the cached emit.
  def vtaConfigSignature = Task.Input {
    // Same property BaseVtaModule.vtaConfigFile reads (Task.Input cannot
    // depend on another task).
    val name = sys.props.getOrElse("vta.config.file", build.defaultConfigName)
    build.configSig(os.Path(name, BuildCtx.workspaceRoot / "config"))
  }

  /** Shared body for vtaSimConfig/vtaFpgaConfig (flat, global-prop-driven) and
    * configs[X]'s versions (cross-value-driven): emit a Chisel config's SV/tcl
    * output with an explicit -Dvta.config.file, scoped to just this call.
    * RunModule.Runner.run's forkArgs parameter *replaces* (not appends to) the
    * module's own default forkArgs, so this works whether the caller wants the
    * global config or a specific cross value.
    */
  def emitConfig(
    runner: mill.javalib.RunModule.Runner,
    dest: os.Path,
    configFileName: String,
    mainClass: String
  )(using ctx: mill.api.TaskCtx): PathRef = {
    runner.run(
      args = Seq(dest.toString),
      mainClass = mainClass,
      forkArgs = Seq(s"-Dvta.config.file=$configFileName"),
      workingDir = BuildCtx.workspaceRoot
    )
    PathRef(dest)
  }

  /** Emit VTAShell.sv for the active config (simulation shell, DPI ports) into
    * a cached dir.
    *
    * This is what vta.simulator's vsim is Verilated from; use
    * [[emitVtaSimConfig]] to get a copy under build/emitted/.
    */
  def vtaSimConfig = Task {
    vtaConfigSignature()
    emitConfig(
      runner(),
      Task.dest,
      vtaConfigFile(),
      "vta.exporters.TestDefaultPynqConfigEmitter"
    )
  }

  /** Copy an emitted-config task's output dir to a stable location under
    * build/emitted, replacing whatever is there. Shared by emitVtaSimConfig and
    * emitVtaFpgaConfig.
    */
  private def exportEmitted(
    src: PathRef,
    outDir: os.Path,
    label: String
  ): Unit = {
    os.remove.all(target = outDir, ignoreErrors = true)
    os.copy(src.path, outDir, replaceExisting = true, createFolders = true)
    println(s"[INFO] emitted $label config to $outDir")
  }

  /** Export the simulation RTL (VTAShell.sv, DPI shell) for the active config
    * to build/emitted/vta-sim-shell/.
    *
    * A convenience copy of [[vtaSimConfig]] for inspecting the SV by hand; the
    * Verilated simulator does not need it.
    *
    * @param args
    *   ignored.
    */
  def emitVtaSimConfig(args: Args) = Task.Command {
    val outDir = BuildCtx.workspaceRoot / "build" / "emitted" / "vta-sim-shell"
    exportEmitted(vtaSimConfig(), outDir, "sim")
  }

  /** Emit the Xilinx RTL plus package_ip.tcl for the active config into a
    * cached dir.
    *
    * The input of the Vivado flow (vta.fpga's fpgaProject / fpgaSynth), which
    * reuses it instead of re-emitting. Depends on the config only, never on a
    * compiled model, and needs no Vivado itself.
    */
  def vtaFpgaConfig = Task {
    vtaConfigSignature()
    emitConfig(
      runner(),
      Task.dest,
      vtaConfigFile(),
      "vta.exporters.DefaultXilinxConfigEmitter"
    )
  }

  /** The same RTL emitters, one independently cached instance per config in
    * config/.
    *
    * Use these to emit for a config other than the global -Dvta.config.file
    * one: `./mill vta.hardware.configs[vta_w8b].vtaFpgaConfig`. The Scala code
    * itself is compiled once, regardless of config.
    */
  object configs extends Cross[ConfigModule](build.configNames)
  trait ConfigModule extends build.ConfigCrossModule {

    /** Emit the simulation RTL (VTAShell.sv) for this config. See
      * vta.hardware.vtaSimConfig.
      */
    def vtaSimConfig = Task {
      configSignature()
      m.emitConfig(
        m.runner(),
        Task.dest,
        s"$configKey.json",
        "vta.exporters.TestDefaultPynqConfigEmitter"
      )
    }

    /** Emit the Xilinx RTL + package_ip.tcl for this config. See
      * vta.hardware.vtaFpgaConfig.
      */
    def vtaFpgaConfig = Task {
      configSignature()
      m.emitConfig(
        m.runner(),
        Task.dest,
        s"$configKey.json",
        "vta.exporters.DefaultXilinxConfigEmitter"
      )
    }
  }

  /** Export the Xilinx RTL + package_ip.tcl for the active config, ready to
    * package as an IP.
    *
    * Only needed to drive Vivado by hand; `vta.fpga.fpgaSynth` consumes
    * [[vtaFpgaConfig]] directly.
    *
    * @param args
    *   optional absolute destination dir (default:
    *   build/emitted/vta-xilinx-shell/).
    */
  def emitVtaFpgaConfig(args: Args) = Task.Command {
    val outDir =
      if (args.value.isEmpty)
        BuildCtx.workspaceRoot / "build" / "emitted" / "vta-xilinx-shell"
      else os.Path(args.value.head)
    exportEmitted(vtaFpgaConfig(), outDir, "fpga")
  }

  /** Emit a SystemVerilog testbench that replays a compiled model against the
    * VTA, for gate-level (post-synthesis) simulation in xsim.
    *
    * Reads a compiler_output dir and writes the TB to
    * build/emitted/vta-postsynth-tb/ by default. Tune it with the JVM
    * properties -Dvta.compilerOutDir, -Dvta.simOutDir, -Dvta.layers,
    * -Dvta.reloStride and -Dvta.perLayerTimeout, which are forwarded to the
    * emitter. -Dvta.simOutDir must point at the fsim `--dump-layers` output
    * (the per-layer input<layer>.bin the TB bakes into its .mem files).
    *
    * @param args
    *   optional absolute destination dir.
    */
  def emitVtaPostSynthTb(args: Args) = Task.Command {
    val outDir =
      if (args.value.isEmpty)
        BuildCtx.workspaceRoot / "build" / "emitted" / "vta-postsynth-tb"
      else os.Path(args.value.head)
    os.makeDir.all(outDir)

    // Forward the optional emit knobs from the Mill JVM's -D props as program
    // args, so they reach the forked run JVM regardless of -D propagation.
    val forwarded =
      Seq(
        "compilerOutDir",
        "simOutDir",
        "layers",
        "reloStride",
        "perLayerTimeout"
      ).flatMap(k => sys.props.get(s"vta.$k").map(v => s"--$k=$v"))

    runner().run(
      args = Seq(outDir.toString) ++ forwarded,
      mainClass = "vta.exporters.DefaultPynqConfigTbEmitter",
      workingDir = BuildCtx.workspaceRoot
    )
    println(s"[INFO] VTA post-synth TB emitted in ${outDir}")
  }

  /** Delete build/ at the repo root: every hand-exported artifact (emitted RTL,
    * testbenches, baremetal workspaces).
    *
    * Does not touch Mill's own cache (out/) - use `./mill clean` for that.
    */
  def cleanOutputs() = Task.Command {
    val outputDir = BuildCtx.workspaceRoot / "build"
    println(s"[Clean] removing all outputs")
    os.remove.all(target = outputDir)
    println(s"[Clean] removed ${outputDir} directory")

  }

  /** The Chisel testbenches: cycle-accurate ScalaTest simulation of the RTL.
    *
    * `test` runs everything, [[unittest]] only the per-module unit tests. They
    * run against the bundled vta_config_test.json unless -Dvta.config.file
    * names another config.
    */
  object test extends SbtTests with ScalaTest {
    override def scalaTestVersion: Simple[String] = "3.2.19"

    def forkEnv = m.forkEnv
    def testSandboxWorkingDir = true
    def testParallelism = true

    /** Config the tests run against, from -Dvta.config.file. None means the
      * in-resources vta_config_test.json.
      */
    def vtaConfigFile = Task.Input {
      sys.props.get("vta.config.file")
    }

    /** The -Dvta.config.* JVM args handed to the forked test JVM. */
    def getConfigArgs = Task {
      (for {
        file <- vtaConfigFile()
      } yield {
        Seq(s"-Dvta.config.file=${file}")
      }).getOrElse {
        Seq(
          "-Dvta.config.file=vta_config_test.json",
          "-Dvta.config.fromResources=true"
        )
      }
    }
    override def forkArgs: Simple[Seq[String]] =
      super.forkArgs() ++ getConfigArgs()

    /** Run only the unit tests (the vta.tags.UnitTests-tagged ones), skipping
      * the slower JSON-driven integration and shell tests.
      */
    def unittest: Simple[(msg: String, results: Seq[TestResult])] = {
      testForked("-n", "vta.tags.UnitTests")()
    }

    /** Run selected tests with waveform dumping on: same as `testOnly`, plus
      * -DemitFst=1, so each test writes an FST trace to its sandbox dir.
      *
      * @param args
      *   the test class names (globs allowed), e.g.
      *   `simulatorTest.ComputeTest`.
      */
    def testWaves(args: String*) = Task.Command {
      testOnly(args ++ Seq("--", "-DemitFst=1")*)()
    }

  }

}
