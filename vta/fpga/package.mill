package build.vta.fpga
import mill.*, mill.scalalib.*
import mill.javalib.TestModule.ScalaTest
import mill.api.Task.Simple
import mill.api.BuildCtx
import build.MyModule

/** Everything that targets a real board: the Vivado synthesis flow (bitstream +
  * XSA), the baremetal code generator, the Vitis workspace, and the host-side
  * checkers.
  *
  * An FPGA build is identified by a (config, board) pair: see [[targets]]. To
  * go from a model to a flashable workspace in one step, prefer
  * `examples[<model>,<config>].createVitisProject`.
  */
object `package` extends MyModule { m =>

  def mvnDeps = Seq(mvn"com.github.scopt::scopt:4.1.0")
  def moduleDeps = Seq(build.vta.hardware)

  /** Board of the flat (non-crossed) synthesis tasks, from -Dvta.board.name
    * (default zcu104). Must name a board JSON under vta/fpga/boards/.
    *
    * The board-crossed [[targets]] take theirs from the cross key instead.
    */
  def vtaBoardName = Task.Input {
    sys.props.getOrElse("vta.board.name", "zcu104")
  }

  /** Generate the baremetal PS headers (nn_exec_plan.h, nn_ddr_map.h,
    * vta_hw_config.h) from a compiler_output dir, for the active config.
    *
    * Raw CLI pass-through, uncached. For an example model, prefer the cached
    * `examples[<model>,<config>].genBaremetal`.
    *
    * @param args
    *   the compiler_output dir, then GenNnBaremetal flags: `--outdir <dir>`,
    *   `--ddr-base 0x10000000`, `--verbose`, `--emit-sd-manifest`, ...
    */
  def genNnBaremetal(args: Args) = Task.Command {
    runner().run(
      args = args.value,
      mainClass = "fpga.host.GenNnBaremetal",
      workingDir = BuildCtx.workspaceRoot
    )
    println(s"[INFO] genNnBaremetal done")
  }

  /** Plain function: run GenNnBaremetal for a specific (compiler-output,
    * config) pair. Takes an already-resolved Runner (callers pass `runner()`
    * from within their own Task{} block) since Task APIs can't be invoked
    * outside one. `configKey` is passed as an explicit forkArgs override
    * (replaces, not appends to, the module's default forkArgs - see
    * RunModule.Runner.run) so this works for any config, not just whatever
    * -Dvta.config.file the enclosing module was invoked with. Used by
    * build.mill's per-example `genBaremetal` pipeline task; the
    * `genNnBaremetal` Command above stays a raw CLI passthrough (using the
    * global config) for the software Makefile's `make gen*` targets.
    */
  def runGenNnBaremetal(
    runner: mill.javalib.RunModule.Runner,
    compDir: os.Path,
    outdir: os.Path,
    configKey: String,
    ddrBase: String,
    extraArgs: Seq[String]
  )(using ctx: mill.api.TaskCtx): Unit =
    runner.run(
      args = Seq(
        compDir.toString,
        "--ddr-base",
        ddrBase,
        "--outdir",
        outdir.toString
      ) ++ extraArgs,
      mainClass = "fpga.host.GenNnBaremetal",
      forkArgs = Seq(s"-Dvta.config.file=$configKey.json"),
      workingDir = BuildCtx.workspaceRoot
    )

  /** Generate init_dram.h, a self-contained n x n GEMM fixture, for the
    * standalone hardware smoke test on the board.
    *
    * @param args
    *   GenInitDramTestGemm flags: `--n 16`, `--outdir <dir>`,
    *   `--compiler-output-dir <dir>` to build the fixture from real binaries,
    *   `--{inp,wgt,acc,out}-storage <dtype>`.
    */
  def genInitDramTestGemm(args: Args) = Task.Command {
    runner().run(
      args = args.value,
      mainClass = "fpga.host.GenInitDramTestGemm",
      workingDir = BuildCtx.workspaceRoot
    )
  }

  /** Print the DDR map a compiled model will occupy on the board (buffer
    * addresses and sizes), and check that it fits.
    *
    * The tool to reach for when a board run reads or writes the wrong DDR
    * region.
    *
    * @param args
    *   the compiler_output dir, then AuditDram flags: `--ddr-base 0x10000000`,
    *   `--max-addr <hex>` to assert every allocation fits below it,
    *   `--config-json <cfg>`.
    */
  def auditDram(args: Args) = Task.Command {
    runner().run(
      args = args.value,
      mainClass = "fpga.host.checkers.AuditDram",
      workingDir = BuildCtx.workspaceRoot
    )
  }

  /** Compare an output file produced on the board against the simulator's
    * reference, de-tiling the VTA block layout first.
    *
    * @param args
    *   the board output file, then CheckOutput flags: `--comp-dir <dir>`,
    *   `--ref <file>`, `--shape C,H,W`, `--detiled` if it is already NCHW.
    */
  def checkOutput(args: Args) = Task.Command {
    runner().run(
      args = args.value,
      mainClass = "fpga.host.checkers.CheckOutput",
      workingDir = BuildCtx.workspaceRoot
    )
  }

  /** OOC-synthesize an emitted shell to a gate-level netlist for post-synth
    * sim.
    *
    * @param args
    *   OocNetlist flags: `--board zcu104`, `--sv-dir <dir>`, `--top
    *   VTAXilinxShell`, `--out <dir>`, `--mode synth|impl`, `--jobs N`,
    *   `--dry-run`.
    */
  def oocNetlist(args: Args) = Task.Command {
    runner().run(
      args = args.value ++ Seq("--vivado", vivado()),
      mainClass = "fpga.synthesis.OocNetlist",
      workingDir = BuildCtx.workspaceRoot,
      propagateEnv = true
    )
    println("[INFO] oocNetlist done")
  }

  /** Compile + run VTAPostSynthTb under xsim (behavioral control or
    * gate-level).
    *
    * @param args
    *   RunXsim flags: `--behavioral` | `--netlist <funcsim.v>`, `--tb <dir>`,
    *   `--out <dir>`, `--layers N`, `--reuse-elab`, `--wave`, `--dry-run`.
    */
  def runXsim(args: Args) = Task.Command {
    runner().run(
      args = args.value,
      mainClass = "fpga.synthesis.RunXsim",
      workingDir = BuildCtx.workspaceRoot,
      propagateEnv = true
    )
    println("[INFO] runXsim done")
  }

  /** Strb-aware compare of an xsim post-synth run's OUT writes vs the fsim
    * golden.
    *
    * @param args
    *   CompareOut flags: `--writes <writes.log>`, `--layers A,B,C`,
    *   `--compiler-out <dir>`, `--golden-dir <dir>`, `--relo-stride 0x200000`.
    */
  def compareOut(args: Args) = Task.Command {
    runner().run(
      args = args.value,
      mainClass = "fpga.synthesis.CompareOut",
      workingDir = BuildCtx.workspaceRoot
    )
  }

  /** Print the 32-bit additive checksum of a file, to compare against what the
    * board's sd_loader_test app prints over UART.
    *
    * @param args
    *   the file to checksum.
    */
  def sdChecksum(args: Args) = Task.Command {
    runner().run(
      args = args.value,
      mainClass = "fpga.host.utils.SdChecksum",
      workingDir = BuildCtx.workspaceRoot
    )
  }

  /** Regenerate the committed host-golden fixtures under
    * vta/fpga/src/test/resources/host-golden/ from a fresh compile of the
    * golden cases.
    *
    * Run it (and review the diff) when a deliberate compiler or codegen change
    * makes the fpga host tests fail.
    */
  def regenHostGolden() = Task.Command {
    val binRoot = test.goldenOutputs().path / "host-golden-bin"
    val goldenRoot =
      BuildCtx.workspaceRoot / "vta" / "fpga" / "src" / "test" / "resources" / "host-golden"
    runner().run(
      args = Seq(binRoot.toString, goldenRoot.toString),
      mainClass = "fpga.host.RegenHostGolden",
      workingDir = BuildCtx.workspaceRoot
    )
    println("[INFO] regenHostGolden done")
  }

  /** Plain (untracked) resolution of the vivado binary from XILINX_VIVADO.
    * Deliberately NOT a Task.Input read via Task.env inside a cached Task: the
    * tool's location is an environment/tooling detail, not build content, so it
    * must not invalidate fpgaProject/fpgaSynth's cache (see below).
    */
  def resolveVivado(env: Map[String, String]): String =
    env
      .get("XILINX_VIVADO")
      .map(p => (os.Path(p) / "bin" / "vivado").toString)
      .getOrElse("vivado")

  /** The vivado executable: $XILINX_VIVADO/bin/vivado, else whatever `vivado`
    * is on PATH.
    */
  def vivado = Task.Input { resolveVivado(Task.env) }

  /** Run the Vivado flow by hand: emit RTL, package the IP, create the project,
    * synthesize, implement and export the XSA.
    *
    * Raw CLI pass-through, uncached and unstaged. Prefer
    * `vta.fpga.targets[<config>,<board>].fpgaSynth`, which caches per (config,
    * board) and reuses Mill's RTL emit.
    *
    * @param args
    *   BuildFpga flags: `--board zcu104`, `--config <cfg.json>`, `--out <dir>`,
    *   `--jobs N`, `--dry-run`, and the `--skip-{emit,package,project,synth}`
    *   stage switches.
    */
  def buildFpga(args: Args) = Task.Command {
    runner().run(
      args = args.value ++ Seq("--vivado", vivado().toString),
      mainClass = "fpga.synthesis.BuildFpga",
      workingDir = BuildCtx.workspaceRoot,
      propagateEnv = true
    )
    println(s"[INFO] buildFpga done")
  }

  /** Plain function: run one stage of the split Vivado build for a given
    * (config, board, out) triple. Shared by fpgaProject (create the project,
    * --skip-synth) and fpgaSynth (reopen it and synth/impl/XSA,
    * --skip-project), for both this module and the per-config Cross submodule
    * below. Always --skip-emit (hardware.vtaFpgaConfig() owns the RTL emit,
    * cached by Mill) and propagateEnv (Vivado needs XILINX_* / DISPLAY).
    * `stageFlags` selects the stage: Seq("--skip-synth") for the project stage,
    * Seq("--skip-package", "--skip-project") for the synth stage. Takes an
    * already-resolved Runner and vivado path since Task APIs can't be invoked
    * outside a Task{} block.
    */
  def runBuildFpga(
    runner: mill.javalib.RunModule.Runner,
    board: String,
    configPath: os.Path,
    emitDir: os.Path,
    outDir: os.Path,
    vivado: String,
    stageFlags: Seq[String]
  )(using ctx: mill.api.TaskCtx): Unit =
    runner.run(
      args = Seq(
        "--board",
        board,
        "--config",
        configPath.toString,
        "--emit-dir",
        emitDir.toString,
        "--skip-emit",
        "--out",
        outDir.toString,
        "--vivado",
        vivado
      ) ++ stageFlags,
      mainClass = "fpga.synthesis.BuildFpga",
      workingDir = BuildCtx.workspaceRoot,
      propagateEnv = true
    )

  /** Copy the synth stage's artifacts (XSA, bitstream, reports, manifest) out
    * of the Vivado project dir and into `dest`, so a synth task's own output
    * dir is self-contained instead of pointing back into the project.
    *
    * Vivado has to run *in* the project dir (that is where the .xpr it reopens
    * lives), so the artifacts are produced there and copied afterwards. The
    * manifest's absolute `xsa` path is rewritten to the copy, keeping the
    * consumers (createVitisProject) pointed at this dir.
    */
  def collectSynthOutputs(
    projectDir: os.Path,
    dest: os.Path,
    board: String
  ): Unit = {
    val xsa = s"vta_$board.xsa"
    os.makeDir.all(dest)
    Seq(
      xsa,
      s"vta_$board.bit",
      s"vta_$board.pdi", // Versal
      "timing_summary.rpt",
      "utilization.rpt"
    )
      .filter(n => os.exists(projectDir / n))
      .foreach(n => os.copy.over(projectDir / n, dest / n))
    val manifest = projectDir / "manifest.json"
    if (os.exists(manifest))
      os.write.over(
        dest / "manifest.json",
        os.read(manifest)
          .replace((projectDir / xsa).toString, (dest / xsa).toString)
      )
    // BuildFpga's own "Done" banner points at the project dir it wrote into;
    // these are the copies the Vitis tasks (and the user) should actually use.
    println(s"\n=== Collected into the task output dir ===")
    println(s"  XSA      : ${dest / xsa}")
    println(s"  Manifest : ${dest / "manifest.json"}")
    println(
      s"  Next     : ./mill -Dvta.board.name=$board " +
        "\"examples[<model>,<config>].createVitisProject\"" +
        " (reads the XSA + CPU from this manifest)"
    )
  }

  /** Package the IP and create the Vivado project + block design for the active
    * config and board, stopping before synthesis.
    *
    * Fast. The project is kept across runs, so you can open it in the Vivado
    * GUI, edit and save it, and [[fpgaSynth]] will reopen that same project.
    * Depends on config, board and RTL only, never on a model. Only one board is
    * cached at a time here; use [[targets]] to keep several.
    */
  // Resolves vivado via resolveVivado(Task.env), not the vivado() Task.Input,
  // so how XILINX_VIVADO is set cannot invalidate the cache - only content can.
  def fpgaProject = Task(persistent = true) {
    val emitDir = build.vta.hardware.vtaFpgaConfig().path
    val board = vtaBoardName()
    val outDir = Task.dest / configKey() / board
    runBuildFpga(
      runner(),
      board,
      vtaConfigPath(),
      emitDir,
      outDir,
      resolveVivado(Task.env),
      Seq("--skip-synth")
    )
    PathRef(outDir)
  }

  /** Synthesize, implement and export the bitstream + XSA for the active config
    * and board. The full FPGA build: slow (Vivado).
    *
    * Creates the project first if needed ([[fpgaProject]]), otherwise reopens
    * it, GUI edits included. The output dir holds the XSA, the bitstream, the
    * timing/utilization reports and manifest.json (which the Vitis tasks read
    * to find the XSA and CPU). Prefer
    * `vta.fpga.targets[<config>,<board>].fpgaSynth`, which caches each board
    * separately.
    */
  def fpgaSynth = Task {
    val projectDir = fpgaProject().path
    val emitDir = build.vta.hardware.vtaFpgaConfig().path
    val board = vtaBoardName()
    runBuildFpga(
      runner(),
      board,
      vtaConfigPath(),
      emitDir,
      projectDir,
      resolveVivado(Task.env),
      Seq("--skip-package", "--skip-project")
    )
    collectSynthOutputs(projectDir, Task.dest, board)
    PathRef(Task.dest)
  }

  /** The same Vivado build, one independently cached instance per (config,
    * board): an FPGA build is identified by both.
    *
    * Address it as `vta.fpga.targets[<config>,<board>]`, e.g. `./mill
    * "vta.fpga.targets[vta_w8b,zcu104].fpgaSynth"`. Boards are the JSONs under
    * vta/fpga/boards/. Each pair keeps its own project and XSA, so switching
    * board does not re-synthesize the other one.
    */
  object targets extends Cross[TargetModule](build.fpgaTargets)
  trait TargetModule extends Cross.Module2[String, String] {
    def configKey: String = crossValue
    def board: String = crossValue2
    def configPath: os.Path = build.configDirPath / s"$configKey.json"

    /** Content hash of this target's config JSON: depend on it to re-run when
      * the config file is edited in place.
      */
    def configSignature = Task { build.configSig(configPath) }

    /** Create the Vivado project for this (config, board), stopping before
      * synthesis. See vta.fpga.fpgaProject.
      */
    // Task.dest is already keyed by (config, board) - out/vta/fpga/targets/
    // <config>/<board>/fpgaProject.dest - so no board subdir here.
    def fpgaProject = Task(persistent = true) {
      val emitDir = build.vta.hardware.configs(configKey).vtaFpgaConfig().path
      configSignature()
      m.runBuildFpga(
        m.runner(),
        board,
        configPath,
        emitDir,
        Task.dest,
        m.resolveVivado(Task.env),
        Seq("--skip-synth")
      )
      PathRef(Task.dest)
    }

    /** Synthesize this (config, board): the output dir holds the XSA, the
      * bitstream, the reports and manifest.json. See vta.fpga.fpgaSynth.
      */
    def fpgaSynth = Task {
      val projectDir = fpgaProject().path
      val emitDir = build.vta.hardware.configs(configKey).vtaFpgaConfig().path
      configSignature()
      m.runBuildFpga(
        m.runner(),
        board,
        configPath,
        emitDir,
        projectDir,
        m.resolveVivado(Task.env),
        Seq("--skip-package", "--skip-project")
      )
      m.collectSynthOutputs(projectDir, Task.dest, board)
      PathRef(Task.dest)
    }
  }

  /** The vitis executable: $XILINX_VITIS/bin/vitis, else whatever `vitis` is on
    * PATH.
    */
  def vitis = Task.Input {
    (for {
      vitisPath <- Task.env.get("XILINX_VITIS")
    } yield {
      (os.Path(vitisPath) / "bin" / "vitis").toString
    }).getOrElse("vitis")
  }

  /** The Python script that builds the Vitis workspace
    * (software/host/create_vitis_workspace.py).
    */
  def vitisScript =
    Task.Source(moduleDir / "software" / "host" / "create_vitis_workspace.py")

  /** Create a Vitis workspace by hand, passing every option yourself.
    *
    * Raw CLI pass-through. Prefer [[createVitisProject]], which fills in the
    * XSA and CPU from a synthesized config for you.
    *
    * @param args
    *   create_vitis_workspace.py flags: `--xsa <file>`, `--cpu
    *   psu_cortexa53_0`, `--gen-dir <baremetal headers>`, `--runner <app>`.
    */
  def createVitisWorkspace(args: Args) = Task.Command {
    os.proc(vitis(), "-s", vitisScript(), args.value).call(stdout = os.Inherit)
    PathRef(Task.dest)
  }

  /** Read a string field out of a BuildFpga manifest.json (xsa, cpu, board,
    * ...).
    */
  def readManifestField(manifestPath: os.Path, key: String): String = {
    val text = os.read(manifestPath)
    s""""$key"\\s*:\\s*"([^"]+)"""".r
      .findFirstMatchIn(text)
      .getOrElse(sys.error(s"ERROR: '$key' not found in $manifestPath"))
      .group(1)
  }

  /** Plain function: create/update a Vitis workspace. genDir is optional so the
    * config-only createVitisProject Command below can omit it (the script falls
    * back to its own software/gen default) while build.mill's per-example task
    * passes a specific model's genBaremetal() output.
    */
  def runCreateVitisWorkspace(
    vitisExe: String,
    script: os.Path,
    xsa: String,
    cpu: String,
    genDir: Option[os.Path],
    workspace: os.Path,
    extraArgs: Seq[String]
  ): Unit =
    os.proc(
      vitisExe,
      "-s",
      script,
      "--xsa",
      xsa,
      "--cpu",
      cpu,
      "--workspace",
      workspace.toString,
      genDir.toSeq.flatMap(d => Seq("--gen-dir", d.toString)),
      extraArgs
    ).call(stdout = os.Inherit)

  /** Create a Vitis workspace in this task's dest for the active config, wired
    * to the XSA it was synthesized into.
    *
    * Synthesizes first if stale ([[fpgaSynth]]) and reads the XSA and CPU out
    * of its manifest, so no paths need copying by hand. Uses the checked-in
    * software/gen/ headers; for a specific model, use
    * `examples[<model>,<config>].createVitisProject` instead.
    *
    * @param args
    *   extra flags forwarded to create_vitis_workspace.py, e.g. `--runner
    *   <app>`, `--data-loader sd`.
    */
  def createVitisProject(args: Args) = Task.Command {
    val synthDir = fpgaSynth().path
    val manifest = synthDir / "manifest.json"
    val outPath = Task.dest / configKey() / vtaBoardName()
    runCreateVitisWorkspace(
      vitis(),
      vitisScript().path,
      readManifestField(manifest, "xsa"),
      readManifestField(manifest, "cpu"),
      None,
      outPath,
      args.value
    )
    PathRef(outPath)
  }

  /** Host-side tests of the FPGA tooling: the baremetal codegen and the
    * checkers, against golden fixtures.
    *
    * Compiles the golden models on the fly (Python compiler on PATH required).
    * Update the fixtures with [[regenHostGolden]] when a change to the output
    * is intended.
    */
  object test extends SbtTests with ScalaTest {
    override def scalaTestVersion: Simple[String] = "3.2.19"
    def forkArgs = m.forkArgs
    // forkEnv is overridden below to also expose the generated golden root.

    /** (case-name, onnx-relpath-under-examples, config-name-under-config). Must
      * match GoldenSupport.cases and the committed host-golden case dirs.
      */
    def goldenCases = Seq(
      ("lenet5-default", "onnx/lenet5.onnx", "vta_config.json"),
      ("lenet5-w8b", "onnx/lenet5.onnx", "vta_w8b.json"),
      ("qyolo-default", "onnx/qyolo_pattern.onnx", "vta_config.json"),
      ("qyolo-w8b", "onnx/qyolo_pattern.onnx", "vta_w8b.json")
    )

    /** Model + config inputs for the golden cases. Compiler CODE invalidation
      * comes from build.vta.compiler.sources(), referenced in compilerOutput.
      */
    def compilerSources = Task.Sources(
      BuildCtx.workspaceRoot / "examples" / "onnx" / "lenet5.onnx",
      BuildCtx.workspaceRoot / "examples" / "onnx" / "qyolo_pattern.onnx",
      BuildCtx.workspaceRoot / "config" / "vta_config.json",
      BuildCtx.workspaceRoot / "config" / "vta_w8b.json"
    )

    /** One cached compile task per golden case (crossValue = case name), so the
      * four Python pipelines run in parallel and invalidate independently.
      *
      * Each stage's output dir is pinned with VTA_COMPILER_OUT, so the whole
      * pipeline stays inside `dest` and never touches the repo-root
      * `compiler_output` (a Make/user scratch dir - clobbering it is what made
      * that directory vanish under the Metals BSP server). Mill caches the
      * result and only re-runs when compilerSources() changes.
      */
    object goldenCase extends Cross[GoldenCaseModule](goldenCases.map(_._1))
    trait GoldenCaseModule extends Cross.Module[String] {
      def compilerOutput = Task {
        build.vta.compiler.sources() // invalidate on compiler-code change
        compilerSources() // invalidate on model/config change
        val (_, onnx, cfg) = goldenCases.find(_._1 == crossValue).get
        val root = BuildCtx.workspaceRoot
        val dest = Task.dest / "compiler_output"
        build.vta.compiler.compileModel(
          build.vta.compiler.pythonExe().path,
          root,
          root / "examples" / os.RelPath(onnx),
          root / "config" / cfg,
          dest,
          Task.env
        )
        PathRef(dest)
      }
    }

    /** Assemble every golden case into the layout GoldenSupport expects
      * (`Task.dest/host-golden-bin/<case>/compiler_output`). It is NOT wired
      * into `resources` (which BSP evaluates eagerly); it is pulled in through
      * the test JVM's `forkEnv` below, so it runs only when tests actually run.
      */
    def goldenCaseOutputs =
      Task.traverse(goldenCases.map(_._1))(name =>
        goldenCase(name).compilerOutput
      )

    def goldenOutputs = Task {
      val binRoot = Task.dest / "host-golden-bin"
      goldenCases.map(_._1).zip(goldenCaseOutputs()).foreach {
        case (name, ref) =>
          os.copy(
            ref.path,
            binRoot / name / "compiler_output",
            createFolders = true
          )
      }
      PathRef(Task.dest)
    }

    // override def resources: Simple[Seq[PathRef]] = Task {
    //   resources() :+ PathRef(moduleDir / "boards")
    // }

    /** Expose the generated golden root to the forked test JVM only. Pulling
      * goldenOutputs() in here (rather than into `resources`) keeps it off the
      * eager BSP compile/discovery path, so the Python compile runs only when a
      * test run actually forks a JVM. GoldenSupport reads VTA_HOST_GOLDEN_BIN.
      */
    def forkEnv = m.forkEnv() ++ Map(
      "VTA_HOST_GOLDEN_BIN" -> (goldenOutputs().path / "host-golden-bin").toString
    )
  }
}
