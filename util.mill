package build

import mill._
import mill.javalib._
import mill.scalalib.SbtModule
import mill.api.BuildCtx
import com.goyeau.mill.scalafix.ScalafixModule

/** Content-hashed view of a config JSON, or None when it does not exist (e.g. a
  * resource-only test config). Shared by every config-signature Task so cached
  * tasks invalidate when the file is edited in place - the forked JVMs only
  * ever receive the config filename, never its contents.
  */
def configSig(path: os.Path): Option[PathRef] =
  BuildCtx.withFilesystemCheckerDisabled {
    if (os.exists(path)) Some(PathRef(path)) else None
  }

/** Default config filename when -Dvta.config.file is unset. */
val defaultConfigName = "vta_config.json"

/** Hardware-config plumbing shared by every VTA module: which config JSON is
  * active, and the tasks that must be invalidated when its content changes.
  *
  * The active config is selected globally with `-Dvta.config.file=<name>.json`
  * (default vta_config.json); the `configs[...]` cross modules take theirs from
  * the cross value instead.
  */
trait BaseVtaModule extends Module {

  /** The config/ directory: every hardware config JSON lives here. */
  def configDir = Task.Source(BuildCtx.workspaceRoot / "config")

  /** All hardware config JSONs available under config/. */
  def configFiles = Task { os.list(configDir().path).filter(_.ext == "json") }

  /** File name of the active config, from -Dvta.config.file (default
    * vta_config.json). Set it to switch the whole build to another config.
    */
  def vtaConfigFile = Task.Input {
    sys.props.getOrElse("vta.config.file", defaultConfigName)
  }

  /** Absolute path to the active config JSON.
    *
    * Falls back to config/<name> when the name is not found there (e.g. a
    * resource-only test config).
    */
  def vtaConfigPath = Task {
    val name = vtaConfigFile()
    configFiles().find(_.last == name).getOrElse(configDir().path / name)
  }

  /** Name of the active config without its ".json" suffix, such as vta_w8b.
    *
    * Keys the per-config build and run output directories.
    */
  def configKey = Task { vtaConfigPath().baseName }

  /** Content hash of the active config JSON: depend on it to make a cached task
    * re-run when the config file is edited in place.
    */
  def configSignature = Task { configSig(vtaConfigPath()) }

  /** DDR base address used by the baremetal codegen, from -Dvta.ddr.base
    * (default 0x0). Must match the board's DDR base, e.g. 0x10000000.
    */
  def vtaDdrBase = Task.Input {
    sys.props.getOrElse("vta.ddr.base", "0x0")
  }
}
trait MyModule extends BaseVtaModule with SbtModule with ScalafixModule {

  def scalaVersion = "2.13.18"

  def forkArgs = Seq(s"-Dvta.config.file=${vtaConfigFile()}")
  def forkEnv = Task.env ++ Map("VTA_ROOT" -> BuildCtx.workspaceRoot.toString)
}

def onnxDir = BuildCtx.workspaceRoot / "examples" / "onnx"

/** The example models under examples/onnx, as cross keys (path relative to
  * onnxDir, extension stripped). watchValue: adding or removing an .onnx file
  * updates the cross entries without touching the build file.
  */
def exampleModels = BuildCtx.watchValue(
  os.list(onnxDir)
    .filter(_.ext == "onnx")
    .map(_.relativeTo(onnxDir).toString.stripSuffix(".onnx"))
    .sorted
)

/** Plain (non-Task) path to config/, so it can be listed eagerly at
  * object-definition time - Cross needs its values before any Task graph
  * exists, same reason onnxDir isn't wrapped in a Task either.
  */
def configDirPath = BuildCtx.workspaceRoot / "config"

/** The config JSONs under config/, as cross keys (extension stripped).
  * watchValue: adding or removing a config file updates the cross entries
  * without touching the build file. Mirrors exampleModels.
  */
def configNames = BuildCtx.watchValue(
  os.list(configDirPath).filter(_.ext == "json").map(_.baseName).sorted
)

/** Every (example model, config) pair - the Cross keys for `examples`. Computed
  * eagerly (not a Task) since Cross needs its values before the task graph
  * exists.
  */
def examplePairs = exampleModels.flatMap(m => configNames.map(c => (m, c)))

/** Plain (non-Task) path to the FPGA board definitions, listed eagerly for the
  * same reason as configDirPath.
  */
def boardsDirPath = BuildCtx.workspaceRoot / "vta" / "fpga" / "boards"

/** The board JSONs under vta/fpga/boards/, as cross keys (extension stripped).
  * watchValue: adding or removing a board file updates the cross entries
  * without touching the build file. Mirrors configNames.
  */
def boardNames = BuildCtx.watchValue(
  os.list(boardsDirPath).filter(_.ext == "json").map(_.baseName).sorted
)

/** Board used by the tasks that are not board-crossed: the `examples` FPGA
  * wiring and the flat vta.fpga tasks. From -Dvta.board.name, default zcu104.
  *
  * Read as a plain value, not a Task.Input, because it selects a Cross instance
  * (`vta.fpga.targets(config, board)`) and Cross keys must be known before the
  * task graph exists. Untracked is fine: a different board resolves to a
  * different, independently cached module instance rather than dirtying one.
  */
def defaultBoardName = sys.props.getOrElse("vta.board.name", "zcu104")

/** Every (config, board) pair - the Cross keys for `vta.fpga.targets`. An FPGA
  * build is identified by both: the config fixes the RTL, the board fixes the
  * pinout and the XSA.
  */
def fpgaTargets = configNames.flatMap(c => boardNames.map(b => (c, b)))

/** A single config's identity, derived directly from a Cross value instead of
  * the global -Dvta.config.file property that BaseVtaModule reads. Mixed into
  * the `configs` Cross submodule of vta.hardware/vta.simulator/ vta.fpga, so
  * each config is an independently addressable, independently cached module
  * instance (vta.simulator.configs[vta_w8b].fsimBinary) - BaseVtaModule and the
  * flat, global-prop-driven tasks it powers are left untouched for the
  * Makefiles/CI that still call them directly.
  */
trait ConfigCrossModule extends Cross.Module[String] {
  def configKey: String = crossValue
  def configPath: os.Path = build.configDirPath / s"$configKey.json"

  /** Content hash of this cross module's config JSON: depend on it to re-run
    * when the config file is edited in place.
    */
  def configSignature = Task { configSig(configPath) }
}
trait ExampleModule extends Cross.Module2[String, String] {
  // crossValue = model, crossValue2 = config key (e.g. "vta_w8b") - a
  // direct Cross value instead of BaseVtaModule's global -Dvta.config.file.
  def configKey: String = crossValue2
  def configPath: os.Path = configDirPath / s"$configKey.json"

  // Board this example's FPGA tasks target. A plain def, not a Task: it indexes
  // the vta.fpga.targets Cross, whose keys must exist before the task graph.
  def fpgaBoard: String = defaultBoardName

  /** Content hash of this example's config JSON: depend on it to re-run when
    * the config file is edited in place.
    */
  def configSignature = Task { configSig(configPath) }

  /** The ONNX model of this example, under examples/onnx. */
  def onnxPath = Task.Source(onnxDir / os.RelPath(s"$crossValue.onnx"))

  /** Output root of this (model, config): out/runs/<model>/<config>/.
    *
    * Holds every artifact of the example - compiler_output/, baremetal/,
    * vitis_proj/. Switching config writes a sibling dir, so runs never clobber
    * each other.
    */
  // Deliberately outside Task.dest: durable across configs and a single
  // documented home (README) instead of Mill's per-task dest dirs.
  def runDir = Task {
    BuildCtx.workspaceRoot / "out" / "runs" / crossValue / configKey
  }

  /** nn_compiler + vta_compiler + ONNX reference. All Mill inputs are resolved
    * by the caller and passed in, so this stays free of task-graph calls. Only
    * wipes its own compiler_output/ subdir of `dir`, since `dir` (runDir()) is
    * now a shared parent also holding baremetal/ and vitis_proj/ written by
    * other tasks.
    */
  private def compileStage(
    python: os.Path,
    root: os.Path,
    onnx: os.Path,
    config: os.Path,
    dir: os.Path,
    env: Map[String, String]
  ): os.Path = {
    val compOut = dir / "compiler_output"
    os.remove.all(compOut)
    os.makeDir.all(compOut)
    build.vta.compiler.compileModel(python, root, onnx, config, compOut, env)
    build.vta.compiler.runReference(python, root, onnx, compOut, env)
    compOut
  }

  private def funcsimStage(
    python: os.Path,
    root: os.Path,
    compOut: os.Path,
    fsim: os.Path,
    fsimFlags: Seq[String],
    env: Map[String, String]
  ): Unit = {
    build.vta.simulator.launchSim(
      fsim,
      Seq("--comp-dir", compOut.toString) ++ fsimFlags,
      root
    )
    build.vta.compiler.runCheck(python, root, compOut, env)
  }

  private def verilatorSimStage(
    python: os.Path,
    root: os.Path,
    compOut: os.Path,
    vsim: os.Path,
    vsimFlags: Seq[String],
    env: Map[String, String]
  ): Unit = {
    build.vta.simulator.launchSim(
      vsim,
      Seq("--comp-dir", compOut.toString) ++ vsimFlags,
      root
    )
    build.vta.compiler.runCheck(python, root, compOut, env, rtl = true)
  }

  /** fsim -> check -> vsim -> check against an already-compiled compiler_output
    * dir. Never invokes the Python compiler.
    */
  private def simStage(
    python: os.Path,
    root: os.Path,
    compOut: os.Path,
    fsim: os.Path,
    fsimFlags: Seq[String],
    vsim: os.Path,
    vsimFlags: Seq[String],
    env: Map[String, String]
  ): Unit = {
    funcsimStage(python, root, compOut, fsim, fsimFlags, env)
    verilatorSimStage(python, root, compOut, vsim, vsimFlags, env)
  }

  /** Compile this model for this config: nn_compiler, vta_compiler and the ONNX
    * reference.
    *
    * Writes the .bin / .csv streams to <runDir>/compiler_output/. Cached:
    * re-runs only when the model, the config content or the compiler sources
    * change.
    */
  def compile = Task {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    build.vta.compiler.sources() // invalidate on compiler-code change
    configSignature() // invalidate on config-content change
    BuildCtx.withFilesystemCheckerDisabled {
      val compOut =
        compileStage(
          python,
          root,
          onnxPath().path,
          configPath,
          runDir(),
          Task.env
        )
      PathRef(compOut)
    }
  }

  /** Full cached validation of this example: compile, then functional (fsim)
    * and Verilated RTL (vsim) simulation, each checked against the ONNX
    * reference.
    *
    * Re-runs only when the compile inputs or the simulator binaries change; use
    * [[run]] to force a fresh simulation.
    */
  def outputs = Task {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val fsim = build.vta.simulator.configs(configKey).fsimBinary().path
    val vsim = build.vta.simulator.configs(configKey).vsimBinary().path
    BuildCtx.withFilesystemCheckerDisabled {
      simStage(python, root, compOut, fsim, Seq(), vsim, Seq(), Task.env)
      PathRef(runDir())
    }
  }

  /** Run the functional (C++) simulator on this example and check its output
    * against the ONNX reference.
    *
    * Compiles the model first if stale. Always simulates, so it is the task to
    * use when passing flags.
    *
    * @param args
    *   extra flags forwarded to the fsim binary, e.g. `--layer 3 --verbose` to
    *   run and print a single VTA layer.
    */
  def fsim(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val fsim = build.vta.simulator.configs(configKey).fsimBinary().path
    funcsimStage(python, root, compOut, fsim, args.value, Task.env)
    BuildCtx.withFilesystemCheckerDisabled { PathRef(runDir()) }
  }

  /** Run the Verilated RTL (Chisel) simulator on this example and check its
    * output against the ONNX reference.
    *
    * Compiles the model first if stale, and rebuilds the RTL/vsim binary if the
    * hardware changed. Always simulates.
    *
    * @param args
    *   extra flags forwarded to the vsim binary, e.g. `--no-timeout`, `--trace`
    *   (waveform per layer), `--layer 3`, `--dump-layers`.
    */
  def vsim(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val vsim = build.vta.simulator.configs(configKey).vsimBinary().path
    verilatorSimStage(python, root, compOut, vsim, args.value, Task.env)
    BuildCtx.withFilesystemCheckerDisabled { PathRef(runDir()) }
  }

  /** Run this example end to end: fsim and vsim, each checked against the ONNX
    * reference.
    *
    * Same coverage as [[outputs]] but always simulates (compilation is still
    * cached). vsim is given --no-timeout.
    *
    * @param args
    *   extra flags forwarded to both simulator binaries, e.g. `--layer 3
    *   --verbose`.
    */
  def run(args: Args) = Task.Command {
    val root = BuildCtx.workspaceRoot
    val python = build.vta.compiler.pythonExe().path
    val compOut = compile().path
    val fsim = build.vta.simulator.configs(configKey).fsimBinary().path
    val vsim = build.vta.simulator.configs(configKey).vsimBinary().path
    simStage(
      python,
      root,
      compOut,
      fsim,
      args.value,
      vsim,
      "--no-timeout" +: args.value,
      Task.env
    )
    BuildCtx.withFilesystemCheckerDisabled { PathRef(runDir()) }
  }

  /** Generate the baremetal PS headers (nn_exec_plan.h, nn_ddr_map.h, ...) for
    * this example into <runDir>/baremetal/.
    *
    * Compiles the model first if stale. No Vivado needed. Cached: re-runs when
    * the compile inputs, the config or -Dvta.ddr.base change.
    */
  // Writes into runDir, never the tracked vta/fpga/software/gen/ dir that a
  // Vitis build reads from: a cached task must not silently overwrite it.
  def genBaremetal = Task {
    val compOut = compile().path
    val outDir = runDir() / "baremetal"
    BuildCtx.withFilesystemCheckerDisabled {
      build.vta.fpga.runGenNnBaremetal(
        build.vta.fpga.runner(),
        compOut,
        outDir,
        configKey,
        build.examples.vtaDdrBase(),
        Seq()
      )
      PathRef(outDir)
    }
  }

  /** Create (or refresh) this example's Vitis workspace in
    * <runDir>/vitis_proj/<board>/, ready to build and flash.
    *
    * Wires it to this example's generated headers ([[genBaremetal]]) and to the
    * XSA synthesized for this (config, board) - vta.fpga.targets - building
    * both first if stale. Requires Vivado and Vitis.
    *
    * The board comes from -Dvta.board.name (default zcu104); each board gets
    * its own workspace, so they do not overwrite each other.
    *
    * @param args
    *   extra flags forwarded to create_vitis_workspace.py, e.g. `--runner
    *   <app>`, `--data-loader sd`.
    */
  def createVitisProject(args: Args) = Task.Command {
    val genDir = genBaremetal().path
    val synthDir =
      build.vta.fpga.targets(configKey, fpgaBoard).fpgaSynth().path
    val manifest = synthDir / "manifest.json"
    val workspace = runDir() / "vitis_proj" / fpgaBoard
    build.vta.fpga.runCreateVitisWorkspace(
      build.vta.fpga.vitis(),
      build.vta.fpga.vitisScript().path,
      build.vta.fpga.readManifestField(manifest, "xsa"),
      build.vta.fpga.readManifestField(manifest, "cpu"),
      Some(genDir),
      workspace,
      args.value
    )
    PathRef(workspace)
  }
}
