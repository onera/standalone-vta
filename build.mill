//| mill-version: 1.1.7
//| mill-jvm-version: 17
//| mill-jvm-opts: ["-Dchisel.project.root=${PWD}"]
//| mvnDeps: ["com.goyeau::mill-scalafix_mill1:0.6.0"]
package build

import mill._
import mill.javalib._
import mill.javalib.spotless.SpotlessModule
import mill.api.BuildCtx
import mill.api.Args

// Doc-comment convention for every task in the *.mill files, so that the
// completion scripts (tools/completions/) and `./mill inspect <task>` both read
// well:
//   * first sentence  - self-contained one-liner; this is ALL that the native
//                       completion menu shows next to the task name.
//   * next 1-3 lines  - what it produces, what it caches on, where it writes.
//                       This is the fzf preview (~4 lines) - keep it short.
//   * @param args     - how the CLI arguments are used, with an example. Doc
//                       tags are stripped by the completion scripts and shown
//                       only by `./mill inspect`, so details belong here.
// Implementation rationale (why persistent, why a Cross module, ...) goes in
// plain `//` comments, which stay out of the user-facing description.
object `package` extends Module with SpotlessModule {

  def spotlessExcludes = Task {
    super.spotlessExcludes() ++ Seq(
      "glob:.*",
      "glob:**/.*",
      "glob:build",
      "glob:build/**"
    )
  }

  /** Persist -Dvta.* options in .mill-jvm-opts so they apply to every later
    * ./mill run.
    *
    * Merges `key=value` pairs into the file, keeping the keys not mentioned;
    * `key=` drops one key, `--reset` deletes the file, no arguments prints the
    * current settings. A -D on the command line still wins for a single run.
    *
    * @param args
    *   `vta.*` assignments, e.g. `./mill configure vta.board.name=te0803
    *   vta.ddr.base=0x10000000`, or the single flag `--reset`.
    */
  def configure(args: Args) = Task.Command {
    // Writes and reads the workspace root, not Task.dest: this is a
    // side-effecting user command, not a cached artifact.
    BuildCtx.withFilesystemCheckerDisabled {
      args.value match {
        case Seq("--reset") =>
          if (os.exists(jvmOptsFile)) {
            os.remove(jvmOptsFile)
            println(s"removed $jvmOptsFile")
          } else println(s"no $jvmOptsFile to remove")
          printOpts(Map.empty)
        case Seq() =>
          printOpts(readOpts().vta)
        case assignments =>
          val current = readOpts()
          val merged = assignments.map(parseAssignment).foldLeft(current.vta) {
            case (acc, (k, "")) => acc - k
            case (acc, (k, v))  => acc + (k -> v)
          }
          writeVtaOpts(merged, current.unmanaged)
          printOpts(merged)
          println("takes effect on the next ./mill invocation")
      }
    }
  }

  private def jvmOptsFile = BuildCtx.workspaceRoot / ".mill-jvm-opts"

  // Keys with a build-side default, printed even when unset so `./mill
  // configure` shows what is actually in effect.
  private def knownDefaults = Seq(
    "vta.board.name" -> defaultBoard,
    "vta.config.file" -> defaultConfigName,
    "vta.ddr.base" -> defaultDdrBase
  )

  private val vtaOptLine = """^-D(vta\.[^=]+)=(.*)$""".r

  private val headerComment =
    "# Generated by ./mill configure - change it with that task, not by hand."

  /** The vta.* assignments in .mill-jvm-opts, plus every other line held
    * verbatim.
    */
  private case class JvmOptsFile(
    vta: Map[String, String],
    unmanaged: Seq[String]
  )

  /** Reads .mill-jvm-opts and returns its vta.* assignments, plus every other
    * line verbatim (in original order) so a re-write does not lose them - e.g.
    * an -Xmx heap flag or a -D the user added by hand. The generated header
    * comment and chisel.project.root line are dropped from `unmanaged` because
    * writeVtaOpts always re-emits both itself.
    */
  private def readOpts(): JvmOptsFile =
    if (!os.exists(jvmOptsFile)) JvmOptsFile(Map.empty, Seq.empty)
    else {
      val lines = os.read.lines(jvmOptsFile)
      val vta = lines.collect { case vtaOptLine(k, v) => k -> v }.toMap
      val unmanaged = lines.filter {
        case `headerComment`                             => false
        case l if l.startsWith("-Dchisel.project.root=") => false
        case vtaOptLine(_, _)                            => false
        case _                                           => true
      }
      JvmOptsFile(vta, unmanaged.toVector)
    }

  private def parseAssignment(arg: String): (String, String) =
    arg match {
      case "--reset" =>
        sys.error("--reset must be the only argument")
      case _ =>
        arg.split("=", 2) match {
          case Array(k, v) if k.startsWith("vta.") => k -> v
          case _ =>
            sys.error(
              s"expected a vta.* assignment such as vta.board.name=te0803, got: $arg"
            )
        }
    }

  private def writeVtaOpts(
    opts: Map[String, String],
    unmanaged: Seq[String]
  ): Unit = {
    // A .mill-jvm-opts file REPLACES the //| mill-jvm-opts header at the top of
    // this file instead of merging with it, so chisel.project.root must be
    // re-emitted here or Chisel elaboration loses it. `unmanaged` carries over
    // any other line (e.g. -Xmx) the user put in the file by hand, since this
    // is now the only place left to set build-JVM options.
    val lines = Seq(
      headerComment,
      s"-Dchisel.project.root=${BuildCtx.workspaceRoot}"
    ) ++ unmanaged ++ opts.toSeq.sorted.map { case (k, v) => s"-D$k=$v" }
    os.write.over(jvmOptsFile, lines.mkString("", "\n", "\n"))
  }

  private def printOpts(opts: Map[String, String]): Unit = {
    val extra = (opts.keySet -- knownDefaults.map(_._1)).toSeq.sorted
    val rows = knownDefaults.map { case (k, dflt) =>
      opts.get(k).map(v => (k, v, "configured")).getOrElse((k, dflt, "default"))
    } ++ extra.map(k => (k, opts(k), "configured"))
    val width = rows.map(_._1.length).max
    rows.foreach { case (k, v, origin) =>
      println(s"${k.padTo(width, ' ')} = $v ($origin)")
    }
  }
}
