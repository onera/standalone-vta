package build.examples

import mill._
import build.modules.VtaPipelineModule
import build.modules.{HasRawIrModel, SimTasks}
import mill.api.BuildCtx

/** One example model built for one config: the full pipeline, keyed by both.
  *
  * The tasks all come from [[build.modules.VtaPipelineModule]]
  * (modules/pipeline.mill); this supplies only the three values that identify
  * the instance. `configKey` is a direct Cross value rather than
  * BaseVtaModule's global -Dvta.config.file.
  */
trait ExampleModule
    extends Cross.Module2[String, String]
    with VtaPipelineModule {

  def configKey = crossValue2

  /** This model's name: the first cross value. */
  def modelKey: String = crossValue

  /** The example models live in examples/onnx. */
  def onnxRoot: os.Path = moduleDir
}

/** One raw VTA IR fixture built for one config: compile and simulate.
  *
  * Composes only the front end and the simulator tasks. The baremetal, Vitis
  * and post-synthesis traits are deliberately absent: they consume NN-mode
  * artifacts, which a fixture compiled without nn_compiler cannot produce.
  */
trait IrExampleModule
    extends Cross.Module2[String, String]
    with HasRawIrModel
    with SimTasks {

  override def moduleDir = super.moduleDir / os.up / "vta_ir" 
  def configKey = crossValue2

  /** This fixture's name: the first cross value. */
  def modelKey: String = crossValue

  /** The fixtures live in examples/vta_ir.
    *
    */
  def irRoot: os.Path = moduleDir

  /** Run both simulators on this fixture and byte-compare their outputs.
    *
    * The check that replaces the reference comparison for a fixture with no
    * golden: fsim and vsim must agree byte for byte. Both read the same cached
    * compile, so they see identical operands. Writes each run to its own
    * subdirectory of this task's dest. Fails the build on a mismatch.
    */
  override def check() = Task.Command {
    val compOut = compile().path
    // Resolved off the module, not off a local val: the Task macro cannot lift
    // a Task#apply() whose receiver is a local val of this block.
    val fsimBin = build.modules.simulator(configKey).fsimBinary().path
    val vsimBin = build.modules.simulator(configKey).vsimBinary().path
    val sim = build.modules.simulator(configKey).runner()
    val compare = build.modules.compiler.runner()
    val fsimOut = Task.dest / "fsim"
    val vsimOut = Task.dest / "vsim"

    sim.launch(
      fsimBin,
      Seq("--comp-dir", compOut.toString, "--output", fsimOut.toString)
        ++ defaultSimFlags
    )
    sim.launch(
      vsimBin,
      Seq("--comp-dir", compOut.toString, "--output", vsimOut.toString)
        ++ defaultSimFlags ++ Seq("--no-timeout")
    )
    compare.runCompare(fsimOut / layerOutputName, vsimOut / layerOutputName)
    PathRef(Task.dest)
  }
}

/** Examples for exercising the Standalone VTA build pipeline
  *   - onnx : full onnx models (nn_compiler -> vta_compiler -> simulation +
  *     fpga)
  *   - ir : raw ir files (vta_compiler -> simulation)
  */
object `package` extends Module {

  private def onnxDir = moduleDir / "onnx"

  /** The example models under examples/onnx, as cross keys (path relative to
    * onnxDir, extension stripped).
    */
  private def exampleModels = BuildCtx.watchValue(
    os.list(onnxDir)
      .filter(_.ext == "onnx")
      .map(_.relativeTo(onnxDir).toString.stripSuffix(".onnx"))
      .sorted
  )

  /** Every (example model, config) pair - the Cross keys for `examples.onnx`.
   */
  private def examplePairs = exampleModels.flatMap(m => build.configNames.map(c => (m, c)))

  /** End-to-end pipelines for every (model, config) pair: compile, simulate,
    * check, generate baremetal.
    *
    * One cross instance per ONNX model in examples/onnx and config in config/;
    * address it as `examples.onnx[<model>,<config>]`, e.g. `./mill
    * "examples.onnx[lenet5,vta_w8b].fsim"`.
    */
  object onnx extends Cross[ExampleModule](examplePairs){
    override def defaultCrossSegments: Seq[String] = Seq("lenet5",build.activeConfigKey)
  }

  /** Plain (non-Task) path to the raw VTA IR fixtures. */
  def vtaIrDir: os.Path = moduleDir / "vta_ir"

  /** The hand-written VTA IR fixtures under examples/vta_ir, as cross keys
    * (extension stripped).
    */
  private def exampleIrModels = BuildCtx.watchValue(
    os.list(vtaIrDir).filter(_.ext == "json").map(_.baseName).sorted
  )

  /** Every (IR fixture, config) pair - the Cross keys for `examples.ir`. */
  private def exampleIrPairs =
    exampleIrModels.flatMap(m => build.configNames.map(c => (m, c)))

  /** End-to-end runs for every (raw VTA IR fixture, config) pair.
    *
    * One cross instance per fixture in examples/vta_ir and config in config/;
    * address it as `examples.ir[<fixture>,<config>]`, e.g. `./mill
    * "examples.ir[matmul_16x16,vta_config].check"`.
    */
  object ir extends Cross[IrExampleModule](exampleIrPairs){
    override def moduleDir = vtaIrDir
  }
}
