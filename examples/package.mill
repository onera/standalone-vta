package build.examples

import mill._
import build.BaseVtaModule

/** One example model built for one config: the full pipeline, keyed by both.
  *
  * The tasks all come from [[VtaPipelineModule]]; this supplies only the three
  * values that identify the instance. `configKey` is a direct Cross value
  * rather than BaseVtaModule's global -Dvta.config.file.
  */
trait ExampleModule
    extends Cross.Module2[String, String]
    with VtaPipelineModule {

  def configKey = crossValue2

  /** This model's name: the first cross value. */
  def modelKey: String = crossValue

  /** The example models live in examples/onnx. */
  def onnxRoot: os.Path = moduleDir / "onnx"
}

/** End-to-end pipelines for every (model, config) pair: compile, simulate,
  * check, generate baremetal.
  *
  * One cross instance per ONNX model in examples/onnx and config in config/;
  * address it as `examples[<model>,<config>]`, e.g. `./mill
  * "examples[lenet5,vta_w8b].run"`.
  */
object `package`
    extends Cross[ExampleModule](build.examplePairs)
    with BaseVtaModule {

  /** The `outputs` (compile + fsim + vsim + check) of every (model, config)
    * pair, as a list of run dirs. Used by [[runAll]].
    */
  def allOutputs =
    Task.traverse(build.examplePairs) { case (m, c) => this(m, c).outputs }

  /** Validate every (model, config) pair and print the run dir of each.
    *
    * Pairs are cached and hermetic, so they run in parallel and only stale ones
    * re-execute. Add Mill's --keep-going to see all failures at once.
    */
  def runAll = Task.Uncached {
    build.examplePairs.zip(allOutputs()).foreach { case ((m, c), out) =>
      println(s"$m/$c -> ${out.path}")
    }
  }
}
